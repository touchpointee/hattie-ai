@inject AuthenticationStateProvider AuthStateProvider
@inject IDbContextFactory<HattieDbContext> DbFactory
@using HattieAI.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@using System.Threading.Tasks

<div class="nav-scrollable">
    <nav class="flex-column">
        <div class="nav-section">Workspace</div>
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2"></i>
                <span class="nav-text">Dashboard</span>
            </NavLink>
        </div>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="clients">
                        <i class="bi bi-people"></i>
                        <span class="nav-text">Clients</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @if (showOperationsSection)
        {
            <div class="nav-section">Operations</div>
            @if (showKnowledgeBase)
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="knowledge-base">
                        <i class="bi bi-book"></i>
                        <span class="nav-text">Knowledge Base</span>
                    </NavLink>
                </div>
            }
            @if (showWebsiteChatbotTools)
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="client-configuration">
                        <i class="bi bi-gear"></i>
                        <span class="nav-text">Configuration</span>
                    </NavLink>
                </div>
            }
            <div class="nav-item">
                <NavLink class="nav-link" href="documentation">
                    <i class="bi bi-file-earmark-text"></i>
                    <span class="nav-text">Documentation</span>
                </NavLink>
            </div>
            @if (showApiIntegrations)
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="api-integrations">
                        <i class="bi bi-plug"></i>
                        <span class="nav-text">API Integrations</span>
                    </NavLink>
                </div>
            }
        }
        @if (showCrmInbox)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="chats">
                    <i class="bi bi-chat-text"></i>
                    <span class="nav-text">Chats</span>
                </NavLink>
            </div>
        }
        @if (showCrm)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="crm">
                    <i class="bi bi-kanban"></i>
                    <span class="nav-text">CRM Kanban</span>
                </NavLink>
            </div>
        }

        @if (showWhatsAppSection)
        {
            <div class="nav-section">WhatsApp Suite</div>
            <div class="nav-item">
                <NavLink class="nav-link" href="whatsapp-setup">
                    <i class="bi bi-whatsapp"></i>
                    <span class="nav-text">WhatsApp Setup</span>
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool isWhatsAppEnabled = false;
    private bool isWebsiteChatbotEnabled = false;
    private bool isAdmin = false;
    private bool isClientUser = false;
    private bool showOperationsSection => isAdmin || isWebsiteChatbotEnabled || isWhatsAppEnabled;
    private bool showKnowledgeBase => isAdmin || isWebsiteChatbotEnabled || isWhatsAppEnabled;
    private bool showWebsiteChatbotTools => isAdmin || isWebsiteChatbotEnabled;
    private bool showWhatsAppSection => isAdmin || isWhatsAppEnabled;
    private bool showCrmInbox => isAdmin || (isClientUser && (isWebsiteChatbotEnabled || isWhatsAppEnabled));
    private bool showCrm => isAdmin || (isClientUser && (isWebsiteChatbotEnabled || isWhatsAppEnabled));
    private bool showApiIntegrations => isAdmin || (isClientUser && (isWebsiteChatbotEnabled || isWhatsAppEnabled));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");
        isClientUser = user.IsInRole("Client");
        var tenantId = user.FindFirst("TenantId")?.Value;

        if (isAdmin)
        {
            isWhatsAppEnabled = true;
        }
        else if (isClientUser && !string.IsNullOrEmpty(tenantId))
        {
            using var context = DbFactory.CreateDbContext();
            var tenant = await context.Tenants.IgnoreQueryFilters().FirstOrDefaultAsync(t => t.TenantId == tenantId || t.Id.ToString() == tenantId);
            isWhatsAppEnabled = tenant?.IsWhatsAppEnabled ?? false;
            isWebsiteChatbotEnabled = tenant?.IsWebsiteChatbotEnabled ?? false;
        }
    }
}

<style>
    .nav-scrollable {
        flex: 1;
        overflow-y: auto;
        padding: 0.9rem 0.75rem;
    }

    .nav-section {
        color: rgba(255, 255, 255, 0.46);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        margin: 1rem 0.45rem 0.42rem;
        text-transform: uppercase;
    }

    .nav-section:first-child {
        margin-top: 0;
    }

    .nav-link {
        color: rgba(255, 255, 255, 0.74);
        padding: 0.68rem 0.76rem;
        border-radius: 8px;
        border: 1px solid transparent;
        transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.72rem;
        font-weight: 700;
        font-size: 0.91rem;
        line-height: 1.5;
        margin-bottom: 0.18rem;
        white-space: nowrap;
        text-decoration: none;
    }

    .nav-link:hover {
        color: #ffffff;
        background-color: rgba(255, 255, 255, 0.09);
        border-color: rgba(255, 255, 255, 0.06);
        transform: translateX(2px);
    }

    .nav-link.active {
        color: #ffffff;
        background: linear-gradient(135deg, #2563eb 0%, #0f766e 100%);
        font-weight: 800;
        border-color: rgba(255, 255, 255, 0.14);
        box-shadow: 0 10px 24px rgba(37, 99, 235, 0.24);
    }

    .nav-link i {
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        flex-shrink: 0;
        line-height: 0;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.06);
        margin-right: 0;
    }

    .nav-link.active i {
        background: rgba(255, 255, 255, 0.18);
    }

    .nav-text {
        position: relative;
        top: 1px;
    }
</style>
