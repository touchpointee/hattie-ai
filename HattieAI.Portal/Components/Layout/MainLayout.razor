@inherits LayoutComponentBase
@using HattieAI.Portal.Auth
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<div class="app-layout @(isSidebarOpen ? "sidebar-open" : "")">
    <!-- Mobile Overlay -->
    <div class="sidebar-overlay" @onclick="CloseSidebar"></div>

    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="brand">
                <div class="brand-logo">
                    <img src="images/hattie.png" alt="Hattie AI" />
                </div>
                <div class="brand-copy">
                    <span class="brand-name">Hattie AI</span>
                    <small>Admin Portal</small>
                </div>
            </div>
            <button class="btn-close-sidebar d-md-none" @onclick="CloseSidebar">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <NavMenu />

        <div class="sidebar-footer">
            <AuthorizeView>
                <Authorized>
                    <div class="portal-status">
                        <span class="status-dot"></span>
                        <span>Portal online</span>
                    </div>
                    <div class="user-profile">
                        <div class="user-avatar">
                            @context.User.Identity?.Name?.Substring(0, 1).ToUpper()
                        </div>
                        <div class="user-info">
                            <span class="user-name">@context.User.Identity?.Name</span>
                            <span class="user-role">@GetUserRole(context.User)</span>
                        </div>
                    </div>
                    <button class="btn-logout-full" @onclick="Logout">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Top Bar -->
        <header class="top-bar">
            <div class="top-bar-left">
                <button class="btn-toggle-sidebar d-md-none" @onclick="ToggleSidebar">
                    <i class="bi bi-list"></i>
                </button>
                <div>
                    <h2 class="page-title">@CurrentPageTitle</h2>
                    <div class="page-subtitle d-none d-md-block">@CurrentPageSubtitle</div>
                </div>
            </div>
            <div class="top-bar-right">
                <a href="documentation" class="help-link" title="Documentation">
                    <i class="bi bi-question-circle"></i>
                    <span class="d-none d-sm-inline">Docs</span>
                </a>
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <a href="clients" class="btn btn-sm btn-primary" title="Add Client">
                            <i class="bi bi-plus-lg"></i>
                            <span class="d-none d-sm-inline ms-1">Client</span>
                        </a>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <div class="content-wrapper">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">x</a>
</div>

<style>
    :root {
        --sidebar-width: 260px;
        --header-height: 72px;
    }

    .app-layout {
        display: flex;
        height: 100vh;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(243, 246, 251, 0)),
            var(--background-color);
        overflow: hidden;
        position: relative;
    }

    /* Sidebar Styles */
    .sidebar {
        width: var(--sidebar-width);
        background: var(--sidebar-gradient);
        color: #ffffff;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        transition: transform 0.3s ease;
        z-index: 100;
        height: 100%;
        box-shadow: 8px 0 32px rgba(15, 23, 42, 0.16);
    }

    .sidebar-header {
        height: var(--header-height);
        display: flex;
        align-items: center;
        padding: 0 1.1rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: -0.01em;
        color: #ffffff;
    }

    .brand-logo {
        width: 40px;
        height: 40px;
        background: var(--primary-gradient);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.25);
    }

    .brand-logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .brand-copy {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
    }

    .brand-copy small {
        color: rgba(255, 255, 255, 0.52);
        font-size: 0.72rem;
        font-weight: 700;
        margin-top: 0.18rem;
    }

    .sidebar-footer {
        margin-top: auto;
        padding: 0.85rem;
        border-top: 1px solid rgba(255,255,255,0.08);
        background: rgba(255, 255, 255, 0.025);
    }

    .portal-status {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        color: rgba(255, 255, 255, 0.68);
        font-size: 0.76rem;
        font-weight: 800;
        margin: 0 0.35rem 0.65rem;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--success-color);
        box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.16);
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.7rem;
        border-radius: 8px;
        transition: background-color 0.2s, border-color 0.2s;
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.04);
    }

    .user-profile:hover {
        background-color: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.14);
    }

    .user-avatar {
        width: 36px;
        height: 36px;
        background: var(--secondary-color);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        color: white;
    }

    .user-info {
        flex: 1;
        display: flex;
        flex-direction: column;
        font-size: 0.85rem;
        overflow: hidden;
    }

    .user-name {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .user-role {
        color: #9ca3af;
        font-size: 0.75rem;
    }

    .btn-logout-full {
        background: rgba(255, 255, 255, 0.1);
        border: none;
        color: #ffffff;
        cursor: pointer;
        padding: 0.75rem;
        border-radius: 8px;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        margin-top: 0.65rem;
        font-weight: 500;
        font-size: 0.9rem;
    }

    .btn-logout-full:hover {
        background: rgba(255, 255, 255, 0.2);
        color: #ffffff;
    }

    /* Main Content Styles */
    .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        width: 100%;
        background-color: transparent;
    }

    .top-bar {
        height: var(--header-height);
        background-color: rgba(255, 255, 255, 0.94);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.35rem;
        box-shadow: var(--shadow-sm);
        z-index: 10;
        backdrop-filter: blur(12px);
    }

    .top-bar-left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .page-title {
        font-size: 1.25rem;
        font-weight: 800;
        margin: 0;
        color: var(--text-color);
    }

    .page-subtitle {
        color: var(--text-muted);
        font-size: 0.82rem;
        margin-top: 0.1rem;
    }

    .help-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 36px;
        padding: 0 0.75rem;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: #ffffff;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 700;
        transition: color 0.2s;
    }

    .help-link:hover {
        color: var(--primary-color);
        border-color: #bfdbfe;
        background: #eff6ff;
    }

    .content-wrapper {
        flex: 1;
        overflow: auto;
        padding: 1.35rem;
    }

    .top-bar-right {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    @@media (min-width: 1200px) {
        .content-wrapper {
            padding: 1.75rem;
        }
    }

    /* Mobile Styles */
    .sidebar-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 90;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .btn-toggle-sidebar {
        background: none;
        border: none;
        font-size: 1.5rem;
        color: var(--text-color);
        padding: 0;
        cursor: pointer;
    }

    .btn-close-sidebar {
        background: none;
        border: none;
        font-size: 1.25rem;
        color: var(--text-muted);
        cursor: pointer;
    }

    @@media (max-width: 768px) {
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            transform: translateX(-100%);
            box-shadow: var(--shadow-lg);
        }

        .app-layout.sidebar-open .sidebar {
            transform: translateX(0);
        }

        .app-layout.sidebar-open .sidebar-overlay {
            opacity: 1;
            pointer-events: auto;
        }

        .top-bar {
            padding: 0 1rem;
        }

        .content-wrapper {
            padding: 1rem;
        }
        
        .sidebar-footer {
            display: flex; /* Show footer on mobile sidebar */
        }
    }
</style>

@code {
    private bool isSidebarOpen = false;
    private string CurrentPath => new Uri(NavManager.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
    private string CurrentPageTitle => CurrentPath switch
    {
        "" => "Dashboard",
        "clients" => "Clients",
        "knowledge-base" => "Knowledge Base",
        "client-configuration" => "Configuration",
        "documentation" => "Documentation",
        "chats" => "Chats",
        "crm" => "CRM Kanban",
        "api-integrations" => "API Integrations",
        "whatsapp-setup" => "WhatsApp Setup",
        _ => "Hattie AI"
    };
    private string CurrentPageSubtitle => CurrentPath switch
    {
        "" => "Live client, conversation, and setup metrics",
        "clients" => "Onboard and manage chatbot clients",
        "knowledge-base" => "Upload, edit, and rebuild client knowledge",
        "client-configuration" => "Languages and website allowlists",
        "documentation" => "Install guides and operating procedures",
        "chats" => "Website chatbot and WhatsApp chats",
        "crm" => "Manage collected customer leads in Kanban stages",
        "api-integrations" => "Connect external APIs for dynamic AI responses",
        "whatsapp-setup" => "Connect Meta WhatsApp credentials",
        _ => "Admin portal"
    };

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void CloseSidebar()
    {
        isSidebarOpen = false;
    }

    private async Task Logout()
    {
        await Task.CompletedTask;
        NavManager.NavigateTo("/auth/logout", forceLoad: true);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            NavManager.LocationChanged += OnLocationChanged;
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Close sidebar when navigating on mobile
        if (isSidebarOpen)
        {
            isSidebarOpen = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
    }
    private static string GetUserRole(ClaimsPrincipal user)
    {
        return user.FindFirst(ClaimTypes.Role)?.Value ?? "User";
    }
}
