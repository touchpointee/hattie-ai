@page "/api-integrations"
@using HattieAI.Domain.Entities
@using HattieAI.Infrastructure.Persistence
@using HattieAI.Infrastructure.Security
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@attribute [Authorize]
@inject IDbContextFactory<HattieDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration
@rendermode InteractiveServer

<PageTitle>API Integrations | Hattie AI</PageTitle>

<div class="portal-page">
    <div class="page-heading">
        <div>
            <h1>API Integrations</h1>
            <p>Connect external APIs for the AI to push and pull data during conversations.</p>
        </div>
        <div class="heading-actions">
            <span class="metric-pill">@integrations.Count integrations</span>
            <span class="metric-pill active-pill">@integrations.Count(i => i.IsActive) active</span>
            <button class="btn btn-primary" @onclick="ShowAddModal">
                <i class="bi bi-plus-lg"></i> Add Integration
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="state-panel">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Loading API integrations...</span>
        </div>
    }
    else if (!integrations.Any())
    {
        <div class="state-panel">
            <i class="bi bi-plug" style="font-size: 2.5rem; color: var(--primary-color);"></i>
            <strong>No API integrations configured</strong>
            <span>Add your first external API to enable the AI to interact with your systems.</span>
            <button class="btn btn-primary mt-2" @onclick="ShowAddModal">
                <i class="bi bi-plus-lg me-1"></i> Add First Integration
            </button>
        </div>
    }
    else
    {
        <div class="api-grid">
            @foreach (var api in integrations)
            {
                <div class="api-card @(api.IsActive ? "" : "inactive")">
                    <div class="api-card-header">
                        <div class="api-info">
                            <div class="api-name">@api.Name</div>
                            <div class="api-description">@api.Description</div>
                        </div>
                        <div class="api-badges">
                            <span class="badge direction-badge @(api.Direction == "Push" ? "push" : "pull")">
                                <i class="bi @(api.Direction == "Push" ? "bi-arrow-up-right" : "bi-arrow-down-left")"></i>
                                @api.Direction
                            </span>
                            <span class="badge method-badge method-@api.HttpMethod.ToLower()">@api.HttpMethod</span>
                        </div>
                    </div>
                    <div class="api-card-body">
                        <div class="api-url">
                            <i class="bi bi-link-45deg"></i>
                            <span>@TruncateUrl(api.Url)</span>
                        </div>
                        <div class="api-meta-row">
                            <div class="api-meta">
                                <i class="bi bi-shield-lock"></i>
                                <span>@api.AuthType</span>
                            </div>
                            <div class="api-meta">
                                <i class="bi bi-graph-up"></i>
                                <span>@api.DailyCallCount / @api.DailyCallLimit today</span>
                            </div>
                            @{
                                var paramCount = GetParameterCount(api.ParameterSchema);
                            }
                            <div class="api-meta">
                                <i class="bi bi-braces"></i>
                                <span>@paramCount param@(paramCount != 1 ? "s" : "")</span>
                            </div>
                        </div>
                    </div>
                    <div class="api-card-actions">
                        <label class="toggle-switch">
                            <input type="checkbox" checked="@api.IsActive" @onchange="@(e => ToggleActive(api))" />
                            <span class="toggle-slider"></span>
                        </label>
                        <button class="btn btn-sm btn-outline-secondary" title="Test" @onclick="@(() => ShowTestModal(api))">
                            <i class="bi bi-play-circle"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="@(() => ShowEditModal(api))">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="@(() => ConfirmDelete(api))">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    @* =============== ADD/EDIT MODAL =============== *@
    @if (showModal)
    {
        <div class="modal-overlay" @onclick="CloseModal">
            <div class="modal-dialog-lg" @onclick:stopPropagation>
                <div class="modal-header-custom">
                    <h3>@(isEditing ? "Edit" : "Add") API Integration</h3>
                    <button class="btn-close-modal" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="modal-tabs">
                    <button class="tab-btn @(activeTab == "general" ? "active" : "")" @onclick="@(() => activeTab = "general")">
                        <i class="bi bi-info-circle"></i> General
                    </button>
                    <button class="tab-btn @(activeTab == "endpoint" ? "active" : "")" @onclick="@(() => activeTab = "endpoint")">
                        <i class="bi bi-globe"></i> Endpoint
                    </button>
                    <button class="tab-btn @(activeTab == "auth" ? "active" : "")" @onclick="@(() => activeTab = "auth")">
                        <i class="bi bi-shield-lock"></i> Auth
                    </button>
                    <button class="tab-btn @(activeTab == "params" ? "active" : "")" @onclick="@(() => activeTab = "params")">
                        <i class="bi bi-braces"></i> Parameters
                    </button>
                    <button class="tab-btn @(activeTab == "body" ? "active" : "")" @onclick="@(() => activeTab = "body")">
                        <i class="bi bi-code-square"></i> Body
                    </button>
                </div>

                <div class="modal-body-custom">
                    @if (activeTab == "general")
                    {
                        <div class="form-group">
                            <label>Integration Name <span class="required">*</span></label>
                            <input type="text" class="form-control" @bind="editModel.Name" placeholder="e.g., Place Order, Check Stock" />
                        </div>
                        <div class="form-group">
                            <label>AI Description <span class="required">*</span></label>
                            <textarea class="form-control" rows="3" @bind="editModel.Description"
                                placeholder="Tell the AI when to use this API. E.g., 'Call this API when the customer confirms they want to place an order and has provided their name and product details.'"></textarea>
                            <small class="form-hint">This natural-language description tells the AI when to trigger this API during conversations.</small>
                        </div>
                        <div class="form-row">
                            <div class="form-group flex-1">
                                <label>Direction</label>
                                <select class="form-control" @bind="editModel.Direction">
                                    <option value="Push">Push — Send data to external system</option>
                                    <option value="Pull">Pull — Fetch data from external system</option>
                                </select>
                            </div>
                            <div class="form-group flex-1">
                                <label>Daily Call Limit</label>
                                <input type="number" class="form-control" @bind="editModel.DailyCallLimit" min="1" max="10000" />
                            </div>
                        </div>
                    }
                    else if (activeTab == "endpoint")
                    {
                        <div class="form-row">
                            <div class="form-group" style="width: 140px;">
                                <label>Method</label>
                                <select class="form-control" @bind="editModel.HttpMethod">
                                    <option value="GET">GET</option>
                                    <option value="POST">POST</option>
                                    <option value="PUT">PUT</option>
                                    <option value="PATCH">PATCH</option>
                                    <option value="DELETE">DELETE</option>
                                </select>
                            </div>
                            <div class="form-group flex-1">
                                <label>URL <span class="required">*</span></label>
                                <input type="text" class="form-control" @bind="editModel.Url" placeholder="https://api.example.com/endpoint" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Extra Headers <small class="text-muted">(JSON key-value pairs)</small></label>
                            <textarea class="form-control code-textarea" rows="3" @bind="editModel.Headers"
                                placeholder='{"Content-Type": "application/json", "X-Custom": "value"}'></textarea>
                        </div>
                    }
                    else if (activeTab == "auth")
                    {
                        <div class="form-group">
                            <label>Authentication Type</label>
                            <select class="form-control" @bind="editModel.AuthType">
                                <option value="None">None</option>
                                <option value="BearerToken">Bearer Token</option>
                                <option value="ApiKey">API Key</option>
                                <option value="BasicAuth">Basic Auth (user:pass)</option>
                            </select>
                        </div>
                        @if (editModel.AuthType != "None")
                        {
                            <div class="form-group">
                                <label>
                                    @(editModel.AuthType == "BearerToken" ? "Bearer Token" :
                                      editModel.AuthType == "ApiKey" ? "API Key Value" : "Credentials (user:password)")
                                    <span class="required">*</span>
                                </label>
                                <input type="password" class="form-control" @bind="editAuthValue"
                                    placeholder="@(isEditing ? "Leave blank to keep existing" : "Enter secret value")" />
                                <small class="form-hint"><i class="bi bi-lock"></i> Stored encrypted at rest using AES-256.</small>
                            </div>
                        }
                        @if (editModel.AuthType == "ApiKey")
                        {
                            <div class="form-group">
                                <label>Header Name</label>
                                <input type="text" class="form-control" @bind="editModel.AuthHeaderName"
                                    placeholder="X-API-Key (default)" />
                            </div>
                        }
                    }
                    else if (activeTab == "params")
                    {
                        <div class="param-section">
                            <div class="param-header">
                                <span>Parameters</span>
                                <button class="btn btn-sm btn-outline-primary" @onclick="AddParameter">
                                    <i class="bi bi-plus"></i> Add
                                </button>
                            </div>
                            @if (!editParameters.Any())
                            {
                                <div class="empty-params">
                                    <i class="bi bi-braces"></i>
                                    <span>No parameters defined. Add parameters that the AI should extract from conversations.</span>
                                </div>
                            }
                            else
                            {
                                @for (int i = 0; i < editParameters.Count; i++)
                                {
                                    var idx = i;
                                    var param = editParameters[idx];
                                    <div class="param-row">
                                        <div class="param-fields">
                                            <input type="text" class="form-control" placeholder="name" @bind="param.Name" />
                                            <select class="form-control param-type" @bind="param.Type">
                                                <option value="string">string</option>
                                                <option value="number">number</option>
                                                <option value="boolean">boolean</option>
                                            </select>
                                            <label class="param-required">
                                                <input type="checkbox" @bind="param.Required" /> Req
                                            </label>
                                        </div>
                                        <input type="text" class="form-control" placeholder="Description (shown to AI)" @bind="param.Description" />
                                        <button class="btn btn-sm btn-outline-danger param-delete" @onclick="@(() => editParameters.RemoveAt(idx))">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    }
                    else if (activeTab == "body")
                    {
                        <div class="form-group">
                            <label>Request Body Template <small class="text-muted">(for POST/PUT/PATCH)</small></label>
                            <textarea class="form-control code-textarea" rows="10" @bind="editModel.RequestBodyTemplate"
                                placeholder='{
  "customer": "{{customer_name}}",
  "product": "{{product_name}}",
  "qty": {{quantity}}
}'></textarea>
                            <small class="form-hint">
                                Use <code>@("{{")</code>param_name<code>@("}}")</code> placeholders that match your parameter names.
                                The AI will fill these in automatically from the conversation.
                            </small>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(saveMessage))
                {
                    <div class="modal-message @(saveSuccess ? "success" : "error")">
                        <i class="bi @(saveSuccess ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
                        @saveMessage
                    </div>
                }

                <div class="modal-footer-custom">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveIntegration" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @(isEditing ? "Update" : "Create") Integration
                    </button>
                </div>
            </div>
        </div>
    }

    @* =============== TEST MODAL =============== *@
    @if (showTestPanel)
    {
        <div class="modal-overlay" @onclick="CloseTestModal">
            <div class="modal-dialog-lg" @onclick:stopPropagation>
                <div class="modal-header-custom">
                    <h3><i class="bi bi-play-circle me-2"></i>Test: @testApi?.Name</h3>
                    <button class="btn-close-modal" @onclick="CloseTestModal"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="modal-body-custom">
                    <p class="text-muted mb-3">Enter sample parameter values to test the API call:</p>
                    @if (testParameters != null)
                    {
                        @foreach (var param in testParameters)
                        {
                            <div class="form-group">
                                <label>
                                    @param.Name
                                    @if (param.Required) { <span class="required">*</span> }
                                    <small class="text-muted">(@param.Type)</small>
                                </label>
                                <input type="text" class="form-control" @bind="param.TestValue"
                                    placeholder="@param.Description" />
                            </div>
                        }
                    }

                    @if (testResult != null)
                    {
                        <div class="test-result @(testResult.IsSuccess ? "success" : "error")">
                            <div class="test-result-header">
                                <span class="status-badge @(testResult.IsSuccess ? "success" : "error")">
                                    @testResult.StatusCode
                                </span>
                                <span>@testResult.IntegrationName</span>
                            </div>
                            <pre class="test-result-body">@testResult.ResponseBody</pre>
                        </div>
                    }
                </div>
                <div class="modal-footer-custom">
                    <button class="btn btn-secondary" @onclick="CloseTestModal">Close</button>
                    <button class="btn btn-primary" @onclick="RunTest" disabled="@isTesting">
                        @if (isTesting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        <i class="bi bi-play-fill me-1"></i> Run Test
                    </button>
                </div>
            </div>
        </div>
    }

    @* =============== DELETE CONFIRM =============== *@
    @if (showDeleteConfirm)
    {
        <div class="modal-overlay" @onclick="@(() => showDeleteConfirm = false)">
            <div class="modal-dialog-sm" @onclick:stopPropagation>
                <div class="modal-header-custom danger">
                    <h3><i class="bi bi-exclamation-triangle me-2"></i> Delete Integration</h3>
                </div>
                <div class="modal-body-custom">
                    <p>Are you sure you want to delete <strong>@deleteTarget?.Name</strong>? This action cannot be undone.</p>
                </div>
                <div class="modal-footer-custom">
                    <button class="btn btn-secondary" @onclick="@(() => showDeleteConfirm = false)">Cancel</button>
                    <button class="btn btn-danger" @onclick="DeleteIntegration">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isAdmin = false;
    private string tenantId = "";
    private List<ApiIntegration> integrations = new();

    // Modal state
    private bool showModal = false;
    private bool isEditing = false;
    private string activeTab = "general";
    private ApiIntegration editModel = new();
    private string editAuthValue = "";
    private List<ParamModel> editParameters = new();
    private string saveMessage = "";
    private bool saveSuccess = false;
    private bool isSaving = false;

    // Test
    private bool showTestPanel = false;
    private ApiIntegration? testApi;
    private List<TestParamModel>? testParameters;
    private ApiTestResult? testResult;
    private bool isTesting = false;

    // Delete
    private bool showDeleteConfirm = false;
    private ApiIntegration? deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");
        tenantId = user.FindFirst("TenantId")?.Value ?? "";

        await LoadIntegrations();
    }

    private async Task LoadIntegrations()
    {
        isLoading = true;
        using var context = DbFactory.CreateDbContext();

        if (isAdmin)
        {
            integrations = await context.ApiIntegrations.IgnoreQueryFilters().OrderByDescending(a => a.CreatedAt).ToListAsync();
        }
        else
        {
            context.CurrentTenantId = tenantId;
            integrations = await context.ApiIntegrations.OrderByDescending(a => a.CreatedAt).ToListAsync();
        }
        isLoading = false;
    }

    private void ShowAddModal()
    {
        isEditing = false;
        activeTab = "general";
        editModel = new ApiIntegration { Direction = "Push", HttpMethod = "POST", AuthType = "None", DailyCallLimit = 100 };
        editAuthValue = "";
        editParameters = new List<ParamModel>();
        saveMessage = "";
        showModal = true;
    }

    private void ShowEditModal(ApiIntegration api)
    {
        isEditing = true;
        activeTab = "general";
        editModel = new ApiIntegration
        {
            Id = api.Id,
            Name = api.Name,
            Description = api.Description,
            HttpMethod = api.HttpMethod,
            Url = api.Url,
            AuthType = api.AuthType,
            AuthHeaderName = api.AuthHeaderName,
            Headers = api.Headers,
            RequestBodyTemplate = api.RequestBodyTemplate,
            Direction = api.Direction,
            IsActive = api.IsActive,
            DailyCallLimit = api.DailyCallLimit,
            TenantId = api.TenantId
        };
        editAuthValue = "";
        editParameters = DeserializeParams(api.ParameterSchema);
        saveMessage = "";
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        saveMessage = "";
    }

    private async Task SaveIntegration()
    {
        isSaving = true;
        saveMessage = "";
        try
        {
            if (string.IsNullOrWhiteSpace(editModel.Name) || string.IsNullOrWhiteSpace(editModel.Url))
            {
                saveMessage = "Name and URL are required.";
                saveSuccess = false;
                isSaving = false;
                return;
            }

            using var context = DbFactory.CreateDbContext();
            context.CurrentTenantId = tenantId;

            var encryptionKey = Configuration["ENCRYPTION_KEY"] ?? Environment.GetEnvironmentVariable("ENCRYPTION_KEY") ?? "";

            // Serialize parameters
            var paramJson = JsonSerializer.Serialize(editParameters.Select(p => new
            {
                name = p.Name,
                type = p.Type,
                required = p.Required,
                description = p.Description
            }));

            if (isEditing)
            {
                var existing = await context.ApiIntegrations.IgnoreQueryFilters().FirstOrDefaultAsync(a => a.Id == editModel.Id);
                if (existing == null)
                {
                    saveMessage = "Integration not found.";
                    saveSuccess = false;
                    isSaving = false;
                    return;
                }

                existing.Name = editModel.Name;
                existing.Description = editModel.Description;
                existing.HttpMethod = editModel.HttpMethod;
                existing.Url = editModel.Url;
                existing.AuthType = editModel.AuthType;
                existing.AuthHeaderName = editModel.AuthHeaderName;
                existing.Headers = editModel.Headers ?? "{}";
                existing.RequestBodyTemplate = editModel.RequestBodyTemplate ?? "{}";
                existing.ParameterSchema = paramJson;
                existing.Direction = editModel.Direction;
                existing.DailyCallLimit = editModel.DailyCallLimit;

                // Only update auth if a new value was provided
                if (!string.IsNullOrEmpty(editAuthValue) && !string.IsNullOrEmpty(encryptionKey))
                {
                    existing.AuthValue = EncryptionHelper.Encrypt(editAuthValue, encryptionKey);
                }

                await context.SaveChangesAsync();
                saveMessage = "Integration updated successfully!";
            }
            else
            {
                var newIntegration = new ApiIntegration
                {
                    Id = Guid.NewGuid(),
                    TenantId = tenantId,
                    Name = editModel.Name,
                    Description = editModel.Description,
                    HttpMethod = editModel.HttpMethod,
                    Url = editModel.Url,
                    AuthType = editModel.AuthType,
                    AuthHeaderName = editModel.AuthHeaderName,
                    Headers = editModel.Headers ?? "{}",
                    RequestBodyTemplate = editModel.RequestBodyTemplate ?? "{}",
                    ParameterSchema = paramJson,
                    Direction = editModel.Direction,
                    IsActive = true,
                    DailyCallLimit = editModel.DailyCallLimit > 0 ? editModel.DailyCallLimit : 100
                };

                if (!string.IsNullOrEmpty(editAuthValue) && !string.IsNullOrEmpty(encryptionKey))
                {
                    newIntegration.AuthValue = EncryptionHelper.Encrypt(editAuthValue, encryptionKey);
                }

                context.ApiIntegrations.Add(newIntegration);
                await context.SaveChangesAsync();
                saveMessage = "Integration created successfully!";
            }

            saveSuccess = true;
            await LoadIntegrations();
            await Task.Delay(800);
            CloseModal();
        }
        catch (Exception ex)
        {
            saveMessage = $"Error: {ex.Message}";
            saveSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ToggleActive(ApiIntegration api)
    {
        using var context = DbFactory.CreateDbContext();
        context.CurrentTenantId = tenantId;
        var entity = await context.ApiIntegrations.IgnoreQueryFilters().FirstOrDefaultAsync(a => a.Id == api.Id);
        if (entity != null)
        {
            entity.IsActive = !entity.IsActive;
            await context.SaveChangesAsync();
            await LoadIntegrations();
        }
    }

    private void ConfirmDelete(ApiIntegration api)
    {
        deleteTarget = api;
        showDeleteConfirm = true;
    }

    private async Task DeleteIntegration()
    {
        if (deleteTarget == null) return;
        using var context = DbFactory.CreateDbContext();
        context.CurrentTenantId = tenantId;
        var entity = await context.ApiIntegrations.IgnoreQueryFilters().FirstOrDefaultAsync(a => a.Id == deleteTarget.Id);
        if (entity != null)
        {
            context.ApiIntegrations.Remove(entity);
            await context.SaveChangesAsync();
        }
        showDeleteConfirm = false;
        deleteTarget = null;
        await LoadIntegrations();
    }

    // ===== TEST =====
    private void ShowTestModal(ApiIntegration api)
    {
        testApi = api;
        testResult = null;
        try
        {
            var paramDefs = JsonSerializer.Deserialize<List<ParamModel>>(api.ParameterSchema,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            testParameters = paramDefs.Select(p => new TestParamModel
            {
                Name = p.Name,
                Type = p.Type,
                Required = p.Required,
                Description = p.Description,
                TestValue = ""
            }).ToList();
        }
        catch
        {
            testParameters = new();
        }
        showTestPanel = true;
    }

    private void CloseTestModal()
    {
        showTestPanel = false;
        testResult = null;
    }

    private async Task RunTest()
    {
        if (testApi == null) return;
        isTesting = true;
        testResult = null;
        StateHasChanged();

        try
        {
            var encryptionKey = Configuration["ENCRYPTION_KEY"] ?? Environment.GetEnvironmentVariable("ENCRYPTION_KEY") ?? "";

            using var httpClient = new HttpClient();
            httpClient.Timeout = TimeSpan.FromSeconds(10);

            var url = testApi.Url;
            HttpRequestMessage request;

            // Build parameters dict
            var parameters = new Dictionary<string, string>();
            if (testParameters != null)
            {
                foreach (var p in testParameters)
                {
                    parameters[p.Name] = p.TestValue ?? "";
                }
            }

            if (testApi.HttpMethod.Equals("GET", StringComparison.OrdinalIgnoreCase))
            {
                if (parameters.Any())
                {
                    var queryParams = string.Join("&",
                        parameters.Select(p => $"{Uri.EscapeDataString(p.Key)}={Uri.EscapeDataString(p.Value)}"));
                    url = url.Contains("?") ? $"{url}&{queryParams}" : $"{url}?{queryParams}";
                }
                request = new HttpRequestMessage(HttpMethod.Get, url);
            }
            else
            {
                var method = testApi.HttpMethod.ToUpperInvariant() switch
                {
                    "POST" => HttpMethod.Post,
                    "PUT" => HttpMethod.Put,
                    "PATCH" => HttpMethod.Patch,
                    "DELETE" => HttpMethod.Delete,
                    _ => HttpMethod.Post
                };
                request = new HttpRequestMessage(method, url);

                var body = testApi.RequestBodyTemplate ?? "{}";
                foreach (var param in parameters)
                {
                    body = body.Replace($"{{{{{param.Key}}}}}", param.Value);
                }
                request.Content = new StringContent(body, System.Text.Encoding.UTF8, "application/json");
            }

            // Auth
            if (!string.IsNullOrEmpty(testApi.AuthType) && testApi.AuthType != "None" && !string.IsNullOrEmpty(testApi.AuthValue) && !string.IsNullOrEmpty(encryptionKey))
            {
                try
                {
                    var decrypted = EncryptionHelper.Decrypt(testApi.AuthValue, encryptionKey);
                    switch (testApi.AuthType)
                    {
                        case "BearerToken":
                            request.Headers.Add("Authorization", $"Bearer {decrypted}");
                            break;
                        case "ApiKey":
                            var headerName = string.IsNullOrEmpty(testApi.AuthHeaderName) ? "X-API-Key" : testApi.AuthHeaderName;
                            request.Headers.Add(headerName, decrypted);
                            break;
                        case "BasicAuth":
                            var encoded = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(decrypted));
                            request.Headers.Add("Authorization", $"Basic {encoded}");
                            break;
                    }
                }
                catch { /* ignore decryption errors in test */ }
            }

            // Extra headers
            if (!string.IsNullOrEmpty(testApi.Headers) && testApi.Headers != "{}")
            {
                try
                {
                    var extraHeaders = JsonSerializer.Deserialize<Dictionary<string, string>>(testApi.Headers);
                    if (extraHeaders != null)
                    {
                        foreach (var h in extraHeaders)
                            request.Headers.TryAddWithoutValidation(h.Key, h.Value);
                    }
                }
                catch { }
            }

            var response = await httpClient.SendAsync(request);
            var responseBody = await response.Content.ReadAsStringAsync();

            // Try to pretty-print JSON
            try
            {
                var parsed = JsonSerializer.Deserialize<JsonElement>(responseBody);
                responseBody = JsonSerializer.Serialize(parsed, new JsonSerializerOptions { WriteIndented = true });
            }
            catch { /* keep as-is */ }

            testResult = new ApiTestResult
            {
                IntegrationName = testApi.Name,
                StatusCode = (int)response.StatusCode,
                ResponseBody = responseBody.Length > 2000 ? responseBody.Substring(0, 2000) + "\n... (truncated)" : responseBody,
                IsSuccess = response.IsSuccessStatusCode
            };
        }
        catch (TaskCanceledException)
        {
            testResult = new ApiTestResult
            {
                IntegrationName = testApi.Name,
                StatusCode = 408,
                ResponseBody = "Request timed out (10 second limit).",
                IsSuccess = false
            };
        }
        catch (Exception ex)
        {
            testResult = new ApiTestResult
            {
                IntegrationName = testApi?.Name ?? "Unknown",
                StatusCode = 0,
                ResponseBody = $"Connection error: {ex.Message}",
                IsSuccess = false
            };
        }
        finally
        {
            isTesting = false;
        }
    }

    // ===== HELPERS =====
    private void AddParameter()
    {
        editParameters.Add(new ParamModel());
    }

    private List<ParamModel> DeserializeParams(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<List<ParamModel>>(json,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
        }
        catch
        {
            return new();
        }
    }

    private int GetParameterCount(string json)
    {
        try
        {
            var list = JsonSerializer.Deserialize<List<object>>(json);
            return list?.Count ?? 0;
        }
        catch { return 0; }
    }

    private string TruncateUrl(string url)
    {
        return url.Length > 50 ? url.Substring(0, 47) + "..." : url;
    }

    // ===== MODELS =====
    private class ParamModel
    {
        public string Name { get; set; } = "";
        public string Type { get; set; } = "string";
        public bool Required { get; set; } = true;
        public string Description { get; set; } = "";
    }

    private class TestParamModel : ParamModel
    {
        public string TestValue { get; set; } = "";
    }

    private class ApiTestResult
    {
        public string IntegrationName { get; set; } = "";
        public int StatusCode { get; set; }
        public string ResponseBody { get; set; } = "";
        public bool IsSuccess { get; set; }
    }
}

