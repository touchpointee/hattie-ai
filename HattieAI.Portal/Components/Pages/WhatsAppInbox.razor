    .message-bubble {
        max-width: 65%;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        position: relative;
        font-size: 0.95rem;
        line-height: 1.4;
    }

    .inbound .message-bubble {
        background: white;
        color: var(--text-color);
        border-bottom-left-radius: 2px;
        border: 1px solid #e2e8f0;
    }

    .outbound .message-bubble {
        background: var(--primary-color);
        color: white;
        border-bottom-right-radius: 2px;
    }

    .message-time {
        font-size: 0.68rem;
        text-align: right;
        margin-top: 0.3rem;
