@page "/whatsapp-inbox"
@page "/chats"
@using HattieAI.Domain.Entities
@using HattieAI.Infrastructure.Persistence
@using HattieAI.Infrastructure.Security
@using HattieAI.Infrastructure.WhatsApp
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = "Client")]
@inject IDbContextFactory<HattieDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject WhatsAppMetaService MetaService
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Chats | Hattie AI</PageTitle>

<div class="portal-page inbox-page-layout">
    <div class="inbox-sidebar">
        <div class="inbox-header">
            <h3><i class="bi bi-chat-left-text-fill text-primary me-2"></i> Chats</h3>
            <span class="badge bg-primary-subtle text-primary">@sessions.Count conversations</span>
        </div>

        @if (isAdmin && tenants.Count > 1)
        {
            <div class="p-2 border-bottom bg-light">
                <select class="form-select form-select-sm" @onchange="OnTenantChanged">
                    @foreach (var t in tenants)
                    {
                        <option value="@t.Id" selected="@(selectedTenantId == t.Id)">@t.Name</option>
                    }
                </select>
            </div>
        }

        @if (selectedTenant != null && availableChannels.Count > 1)
        {
            <div class="channel-filters">
                <button type="button" class="channel-filter @(channelFilter == "All" ? "active" : "")" @onclick='() => SetChannelFilter("All")'>
                    All
                </button>
                @foreach (var channel in availableChannels)
                {
                    <button type="button" class="channel-filter @(channelFilter == channel ? "active" : "")" @onclick="() => SetChannelFilter(channel)">
                        @GetFilterLabel(channel)
                    </button>
                }
            </div>
        }

        <div class="thread-list">
            @foreach (var session in sessions)
            {
                var lastMsg = lastMessages.TryGetValue(session.Id, out var msg) ? msg : "No messages";
                var isSelected = activeSession?.Id == session.Id;
                var sessionTitle = GetSessionTitle(session);
                <button class="thread-row @(isSelected ? "active" : "")" @onclick="() => SelectSession(session)">
                    <div class="thread-avatar @GetChannelAvatarClass(session)">
                        @GetAvatarText(sessionTitle)
                    </div>
                    <div class="thread-details">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <strong class="text-truncate">@sessionTitle</strong>
                            <small class="text-muted text-xxs">@session.CreatedAt.ToLocalTime().ToString("t")</small>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="last-message text-truncate text-muted">@lastMsg</span>
                            <span class="source-chip @GetChannelBadgeClass(session)">Source: @GetLeadSourceLabel(session)</span>
                        </div>
                    </div>
                </button>
            }
            @if (!sessions.Any())
            {
                <div class="text-center py-5 text-muted small">
                    <i class="bi bi-chat-left-dots fs-3 mb-2 d-block text-muted"></i>
                    <span>@GetEmptyStateMessage()</span>
                </div>
            }
        </div>
    </div>

    <div class="chat-viewport">
        @if (activeSession == null)
        {
            <div class="state-panel embedded">
                <i class="bi bi-chat-left-text-fill text-primary fs-1 mb-2"></i>
                <strong>Select a conversation</strong>
                <span>Choose a chat from the sidebar to view the conversation history.</span>
            </div>
        }
        else
        {
            var activeTitle = GetSessionTitle(activeSession!);
            <div class="chat-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="thread-avatar header-avatar @GetChannelAvatarClass(activeSession!)">
                        @GetAvatarText(activeTitle)
                    </div>
                    <div>
                        <h4 class="mb-1 fw-bold">@activeTitle</h4>
                        <div class="session-meta">
                            <span class="source-chip @GetChannelBadgeClass(activeSession!)">Source: @GetLeadSourceLabel(activeSession!)</span>
                            <span class="session-id badge bg-light text-muted font-monospace text-xxs border">@GetSessionIdentifier(activeSession!)</span>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (IsWhatsAppChannel(activeSession))
                    {
                        @if (activeSession.IsAiPaused)
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle py-1.5 px-2.5 rounded d-inline-flex align-items-center gap-1.5 small">
                                <span class="spinner-grow spinner-grow-sm text-warning" style="width: 8px; height: 8px;" role="status"></span>
                                AI Bot Paused
                            </span>
                            <button class="btn btn-sm btn-success" @onclick="ToggleAiPause" disabled="@isSending">
                                <i class="bi bi-play-fill"></i> Resume AI
                            </button>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle py-1.5 px-2.5 rounded d-inline-flex align-items-center gap-1.5 small">
                                <span class="position-relative d-inline-flex align-items-center" style="width: 8px; height: 8px;">
                                    <span class="position-absolute inline-flex h-100 w-100 rounded-full bg-success opacity-75 animate-ping"></span>
                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-success"></span>
                                </span>
                                AI Bot Active
                            </span>
                            <button class="btn btn-sm btn-outline-warning" @onclick="ToggleAiPause" disabled="@isSending">
                                <i class="bi bi-pause-fill"></i> Pause AI
                            </button>
                        }
                    }
                    <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshActiveMessages">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </button>
                </div>
            </div>

            <div class="chat-messages-container" id="chat-messages-body">
                @foreach (var msg in activeMessages)
                {
                    var isUser = msg.Role == "user";
                    <div class="message-bubble-row @(isUser ? "inbound" : "outbound")">
                        <div class="message-bubble shadow-sm">
                            <div class="message-content">@msg.Content</div>
                            <div class="message-time">@msg.CreatedAt.ToLocalTime().ToString("t")</div>
                        </div>
                    </div>
                }
                @if (!activeMessages.Any())
                {
                    <div class="text-center py-5 text-muted">No messages found.</div>
                }
            </div>

            <!-- Chat Input Footer -->
            <div class="chat-footer">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-1 px-3 mb-2 text-xs d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-exclamation-triangle-fill"></i> @errorMessage</span>
                        <button type="button" class="btn-close text-xs" style="padding: 0.25rem 0.5rem;" @onclick='() => errorMessage = ""'></button>
                    </div>
                }
                @if (CanReplyToActiveSession)
                {
                    <div class="input-row">
                        <textarea class="form-control" rows="2" placeholder="Type your WhatsApp reply to @activeTitle..." @bind="replyText" @onkeydown="HandleKeyDown" disabled="@isSending"></textarea>
                        <button class="btn btn-primary send-btn" @onclick="SendMessage" disabled="@(isSending || string.IsNullOrWhiteSpace(replyText))">
                            @if (isSending)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                            }
                            else
                            {
                                <i class="bi bi-send-fill"></i>
                            }
                        </button>
                    </div>
                }
                else
                {
                    <div class="crm-readonly-note">
                        <i class="bi bi-info-circle text-primary"></i>
                        <div>
                            <strong>Website chatbot</strong>
                            <span>This conversation came from the website chatbot. Manual replies are available for WhatsApp only.</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .inbox-page-layout {
        display: grid;
        grid-template-columns: 320px 1fr;
        height: calc(100vh - 120px);
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-md);
        margin-top: 1rem;
        gap: 0 !important;
    }

    /* Sidebar */
    .inbox-sidebar {
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        background: #f8fafc;
        height: 100%;
        overflow: hidden;
    }

    .inbox-header {
        padding: 1rem;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
    }

    .inbox-header h3 {
        margin: 0;
        font-size: 1rem;
        font-weight: 800;
    }

    .channel-filters {
        display: flex;
        gap: 0.4rem;
        padding: 0.75rem;
        border-bottom: 1px solid var(--border-color);
        background: white;
    }

    .channel-filter {
        border: 1px solid var(--border-color);
        background: #f8fafc;
        color: var(--text-muted);
        border-radius: 8px;
        padding: 0.42rem 0.68rem;
        font-size: 0.78rem;
        font-weight: 800;
        line-height: 1;
    }

    .channel-filter.active {
        background: #eff6ff;
        color: #2563eb;
        border-color: rgba(37, 99, 235, 0.32);
    }

    .thread-list {
        flex: 1;
        overflow-y: auto;
        padding: 0.5rem;
    }

    .thread-row {
        width: 100%;
        border: none;
        background: transparent;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0.75rem;
        border-radius: 8px;
        text-align: left;
        color: var(--text-color);
        transition: all 0.2s ease;
        margin-bottom: 0.35rem;
    }

    .thread-row:hover {
        background: #e2e8f0;
    }

    .thread-row.active {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .thread-avatar {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: var(--primary-gradient);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.95rem;
