    .input-row {
        display: flex;
        gap: 0.8rem;
        align-items: flex-end;
    }

    .input-row textarea {
        resize: none;
        padding: 0.6rem 0.8rem !important;
        min-height: 48px;
    }

    .send-btn {
        width: 48px;
        height: 48px;
        border-radius: var(--border-radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        padding: 0 !important;
    }

    .crm-readonly-note {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.9rem 1rem;
        border: 1px solid rgba(37, 99, 235, 0.18);
        border-radius: 8px;
        background: #eff6ff;
        color: var(--text-color);
        font-size: 0.85rem;
