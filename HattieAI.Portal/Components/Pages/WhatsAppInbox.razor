    @@media (max-width: 760px) {
        .inbox-page-layout {
            grid-template-columns: 1fr;
            height: auto;
            min-height: calc(100vh - 140px);
        }

        .inbox-sidebar {
            max-height: 320px;
            border-right: 0;
            border-bottom: 1px solid var(--border-color);
        }

        .chat-viewport {
            min-height: 520px;
        }

        .message-bubble {
            max-width: 86%;
        }
    }
</style>

@code {
    private bool isAdmin = false;
    private string currentTenantId = string.Empty;
    private List<Tenant> tenants = new();
    private Guid selectedTenantId;
    private Tenant? selectedTenant;

    // CRM lead list
    private List<ChatSession> sessions = new();
    private Dictionary<Guid, string> lastMessages = new();
    private List<string> availableChannels = new();
    private string channelFilter = "All";

    // Active lead
    private ChatSession? activeSession;
    private List<ChatMessage> activeMessages = new();
    private string replyText = "";
    private bool isSending = false;
    private string errorMessage = "";
    private bool CanReplyToActiveSession => IsWhatsAppChannel(activeSession);

    private System.Threading.Timer? pollTimer;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");
        currentTenantId = user.FindFirst("TenantId")?.Value ?? string.Empty;

        using var context = DbFactory.CreateDbContext();
        if (isAdmin)
        {
            tenants = await context.Tenants
                .IgnoreQueryFilters()
                .Where(t => t.IsWebsiteChatbotEnabled || t.IsWhatsAppEnabled)
                .OrderBy(t => t.Name)
                .ToListAsync();

            if (tenants.Any())
            {
                selectedTenantId = tenants[0].Id;
                selectedTenant = tenants[0];
            }
        }
        else if (!string.IsNullOrEmpty(currentTenantId))
        {
            selectedTenant = await context.Tenants.IgnoreQueryFilters().FirstOrDefaultAsync(t => t.TenantId == currentTenantId);
            if (selectedTenant != null)
            {
                selectedTenantId = selectedTenant.Id;
            }
        }

        await LoadTenantSessions();

        // Parse query parameter to preselect active session
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("sessionId", out var sessIdVal))
        {
            if (Guid.TryParse(sessIdVal, out var parsedSessId))
            {
                var targetSession = sessions.FirstOrDefault(s => s.Id == parsedSessId);
                if (targetSession != null)
                {
                    activeSession = targetSession;
                    await RefreshActiveMessages();
                }
            }
        }

        // Start background polling every 5 seconds to load new messages automatically
        pollTimer = new System.Threading.Timer(async _ => 
        {
            await InvokeAsync(async () => 
            {
                await LoadTenantSessions();
                StateHasChanged();
            });
        }, null, 5000, 5000);
    }

    private async Task LoadTenantSessions()
    {
        if (selectedTenant == null)
        {
            sessions.Clear();
            lastMessages.Clear();
            availableChannels.Clear();
            activeSession = null;
            activeMessages.Clear();
            return;
        }

        availableChannels = GetEnabledChannels(selectedTenant);
        if (!availableChannels.Contains(channelFilter) && channelFilter != "All")
        {
            channelFilter = "All";
        }

        if (!availableChannels.Any())
        {
            sessions.Clear();
            lastMessages.Clear();
            activeSession = null;
            activeMessages.Clear();
            return;
        }

        var tenantIdString = selectedTenant.Id.ToString();
        var includeWebsite = selectedTenant.IsWebsiteChatbotEnabled;
        var includeWhatsApp = selectedTenant.IsWhatsAppEnabled;

        using var context = DbFactory.CreateDbContext();
        var query = context.ChatSessions
            .IgnoreQueryFilters()
            .Where(s => s.TenantId == tenantIdString);

        if (channelFilter == "Website")
        {
            query = query.Where(s => includeWebsite && (s.Channel == "Website" || s.Channel == ""));
        }
        else if (channelFilter == "WhatsApp")
        {
            query = query.Where(s => includeWhatsApp && s.Channel == "WhatsApp");
        }
        else
        {
            query = query.Where(s =>
                (includeWebsite && (s.Channel == "Website" || s.Channel == "")) ||
                (includeWhatsApp && s.Channel == "WhatsApp"));
        }

        sessions = await query.OrderByDescending(s => s.CreatedAt).ToListAsync();

        // Get last message text for preview
        lastMessages.Clear();
        var sessionIds = sessions.Select(s => s.Id).ToList();
        var messages = sessionIds.Any()
            ? await context.ChatMessages
                .IgnoreQueryFilters()
                .Where(m => sessionIds.Contains(m.ChatSessionId))
                .OrderBy(m => m.CreatedAt)
                .ToListAsync()
            : new List<ChatMessage>();

        foreach (var session in sessions)
        {
            var lastMsg = messages.LastOrDefault(m => m.ChatSessionId == session.Id);
            lastMessages[session.Id] = lastMsg?.Content ?? "No messages";
        }

        if (activeSession != null)
        {
            // Keep active session if still exists
            var updatedActive = sessions.FirstOrDefault(s => s.Id == activeSession.Id);
            if (updatedActive != null)
            {
                activeSession = updatedActive;
                await RefreshActiveMessages();
            }
            else
            {
                activeSession = null;
                activeMessages.Clear();
            }
        }
    }

    private async Task OnTenantChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var parsedId))
        {
            selectedTenantId = parsedId;
            selectedTenant = tenants.FirstOrDefault(t => t.Id == selectedTenantId);
            channelFilter = "All";
            activeSession = null;
            activeMessages.Clear();
            await LoadTenantSessions();
        }
    }

    private async Task SetChannelFilter(string channel)
    {
        channelFilter = channel;
        activeSession = null;
        activeMessages.Clear();
        replyText = "";
        errorMessage = "";
        await LoadTenantSessions();
    }

    private async Task SelectSession(ChatSession session)
    {
        activeSession = session;
        errorMessage = "";
        replyText = "";
        await RefreshActiveMessages();
    }

    private async Task RefreshActiveMessages()
    {
        if (activeSession == null) return;

        using var context = DbFactory.CreateDbContext();
        activeMessages = await context.ChatMessages
            .IgnoreQueryFilters()
            .Where(m => m.ChatSessionId == activeSession.Id)
            .OrderBy(m => m.CreatedAt)
            .ToListAsync();

        StateHasChanged();
    }

    private async Task SendMessage()
    {
        if (activeSession == null || string.IsNullOrWhiteSpace(replyText)) return;
        if (!CanReplyToActiveSession)
        {
            errorMessage = "Manual replies are available for WhatsApp leads only.";
            return;
        }

        isSending = true;
        errorMessage = "";
        var messageContent = replyText.Trim();

        try
        {
            using var context = DbFactory.CreateDbContext();
            
            // Fetch configuration to get AccessToken
            var config = await context.WhatsAppConfigs
                .IgnoreQueryFilters()
                .FirstOrDefaultAsync(c => c.TenantId == selectedTenantId.ToString());

            if (config == null || string.IsNullOrEmpty(config.PhoneNumberId))
            {
                errorMessage = "WhatsApp config not found for this client.";
                isSending = false;
                return;
            }

            var encryptionKey = Configuration["ENCRYPTION_KEY"] ?? Environment.GetEnvironmentVariable("ENCRYPTION_KEY") ?? "";
            if (string.IsNullOrEmpty(encryptionKey))
            {
                errorMessage = "Encryption key not configured on server.";
                isSending = false;
                return;
            }

            var decryptedToken = EncryptionHelper.Decrypt(config.AccessToken, encryptionKey);

            // Send via Meta API
            var messageId = await MetaService.SendTextMessageAsync(config.PhoneNumberId, decryptedToken, activeSession.UserId, messageContent);

            // Save Outbound Message to DB
            var chatMsg = new ChatMessage
            {
                Id = Guid.NewGuid(),
                ChatSessionId = activeSession.Id,
                Role = "model",
                Content = messageContent,
                TenantId = selectedTenantId.ToString(),
                CreatedAt = DateTime.UtcNow
            };
            context.ChatMessages.Add(chatMsg);

            // Auto-pause AI since agent is replying manually
            var dbSession = await context.ChatSessions
                .IgnoreQueryFilters()
                .FirstOrDefaultAsync(s => s.Id == activeSession.Id);
            if (dbSession != null)
            {
                dbSession.IsAiPaused = true;
                activeSession.IsAiPaused = true; // Sync state
            }

            await context.SaveChangesAsync();

            replyText = "";
            
            // Reload
            await RefreshActiveMessages();
            await LoadTenantSessions();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to send WhatsApp message: {ex.Message}";
        }
        finally
        {
            isSending = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (CanReplyToActiveSession && e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task ToggleAiPause()
    {
        if (activeSession == null) return;
        try
        {
            using var context = DbFactory.CreateDbContext();
            var dbSession = await context.ChatSessions
                .IgnoreQueryFilters()
                .FirstOrDefaultAsync(s => s.Id == activeSession.Id);
            if (dbSession != null)
            {
                dbSession.IsAiPaused = !dbSession.IsAiPaused;
                await context.SaveChangesAsync();
                activeSession.IsAiPaused = dbSession.IsAiPaused;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update AI status: {ex.Message}";
        }
    }

    private static List<string> GetEnabledChannels(Tenant tenant)
    {
        var channels = new List<string>();
        if (tenant.IsWebsiteChatbotEnabled)
        {
            channels.Add("Website");
        }

        if (tenant.IsWhatsAppEnabled)
        {
            channels.Add("WhatsApp");
        }

        return channels;
    }

    private static bool IsWhatsAppChannel(ChatSession? session)
    {
        return string.Equals(session?.Channel, "WhatsApp", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetLeadSourceLabel(ChatSession session)
    {
        return IsWhatsAppChannel(session) ? "WhatsApp" : "Website Chatbot";
    }

    private static string GetFilterLabel(string channel)
    {
        return channel == "Website" ? "Website Chatbot" : channel;
    }

    private static string GetChannelBadgeClass(ChatSession session)
    {
        return IsWhatsAppChannel(session) ? "whatsapp" : "website";
    }

    private static string GetChannelAvatarClass(ChatSession session)
    {
        return IsWhatsAppChannel(session) ? "whatsapp-avatar" : "website-avatar";
    }

    private static string GetSessionTitle(ChatSession session)
    {
        if (!string.IsNullOrWhiteSpace(session.ContactName))
        {
            return session.ContactName;
        }

        if (IsWhatsAppChannel(session) && !string.IsNullOrWhiteSpace(session.UserId))
        {
            return session.UserId;
        }

        if (!string.IsNullOrWhiteSpace(session.Title) && session.Title != "New Chat")
        {
            return session.Title;
        }

        return IsWhatsAppChannel(session) ? "WhatsApp contact" : "Website visitor";
    }

    private static string GetSessionIdentifier(ChatSession session)
    {
        if (IsWhatsAppChannel(session) && !string.IsNullOrWhiteSpace(session.UserId))
        {
            return session.UserId;
        }

        var id = session.Id.ToString("N");
        return $"Session {id.Substring(0, 8)}";
    }

    private string GetEmptyStateMessage()
    {
        if (selectedTenant == null || !availableChannels.Any())
        {
            return "Chat functions are not enabled for this account.";
        }

        return channelFilter == "All"
            ? "No chats found yet."
            : $"No {GetFilterLabel(channelFilter)} chats found yet.";
    }

    private static string GetAvatarText(string value)
    {
        if (string.IsNullOrEmpty(value)) return "?";
        value = value.Trim().TrimStart('+');
        return value.Length > 0 ? value[0].ToString().ToUpperInvariant() : "?";
    }

    public void Dispose()
    {
        pollTimer?.Dispose();
    }
}
