    }

    .source-chip {
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.18rem 0.5rem;
        font-size: 0.68rem;
        font-weight: 800;
        line-height: 1;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .source-chip.website {
        color: #1d4ed8;
        background: #eff6ff;
