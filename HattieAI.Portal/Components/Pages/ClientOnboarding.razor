@page "/clients"
@using HattieAI.Domain.Entities
@using HattieAI.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IDbContextFactory<HattieDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@rendermode InteractiveServer

<PageTitle>Clients | Hattie AI</PageTitle>

<div class="portal-page clients-page">
<div class="page-header">
    <div class="header-content">
        <h1>Client Management</h1>
        <p class="text-muted">Onboard new clients and manage existing integrations.</p>
    </div>
    <div class="heading-actions">
        <span class="metric-pill">@tenants.Count clients</span>
        <span class="metric-pill">@tenants.Count(t => t.IsWebsiteChatbotEnabled) web enabled</span>
        <span class="metric-pill">@tenants.Count(t => t.IsWhatsAppEnabled) WhatsApp</span>
    </div>
</div>

<div class="content-grid">
    <!-- Create Client Card -->
    <div class="card">
        <div class="card-header">
            <h3>
                <i class="@(isEditing ? "bi bi-pencil-square" : "bi bi-person-plus-fill") me-2"></i> 
                @(isEditing ? "Edit Client" : "Onboard New Client")
            </h3>
        </div>
        <div class="card-body">
            <EditForm Model="@newTenant" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                    </div>
                }

                <div class="form-group mb-3">
                    <label class="form-label">Client Name</label>
                    <InputText class="form-control" @bind-Value="newTenant.Name" placeholder="e.g. Acme Corp" />
                    <small class="text-muted">Use the public business name visitors will recognize.</small>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Contact Email</label>
                    <InputText type="email" class="form-control" @bind-Value="newTenant.ContactEmail" placeholder="support@example.com" />
                    <small class="text-muted">Used for portal login and internal client records.</small>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Direct Contact Phone</label>
                    <InputText class="form-control" @bind-Value="newTenant.ContactPhone" placeholder="+1 555 0100" />
                    <small class="text-muted">Shown to visitors when the bot cannot answer or the token limit is reached.</small>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Client Portal Username</label>
                    <InputText class="form-control" @bind-Value="clientUsername" placeholder="acme-client" autocomplete="off" />
                    <small class="text-muted">The client uses this username on the same login page.</small>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Client Portal Password</label>
                    <InputText type="password" class="form-control" @bind-Value="clientPassword" placeholder="Set client password" autocomplete="new-password" />
                    <small class="text-muted">@(isEditing ? "Leave blank to keep the existing password." : "Required when creating a client.")</small>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Custom Welcome Message</label>
                    <InputText class="form-control" @bind-Value="newTenant.WelcomeMessage" placeholder="e.g. Hello! How can I help you today?" />
                    <small class="text-muted">The first message Hattie displays to the website visitors.</small>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Max Response Tokens</label>
                    <InputNumber class="form-control" @bind-Value="newTenant.MaxTokensPerSession" min="200" max="8000" />
                    <small class="text-muted">Maximum response length / context safety ceiling.</small>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Monthly Token Limit</label>
                    <InputNumber class="form-control" @bind-Value="newTenant.MonthlyTokenLimit" min="1000" max="10000000" />
                    <small class="text-muted">AI replies stop when this monthly usage limit is reached.</small>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label">System Instruction</label>
                    <InputTextArea class="form-control" @bind-Value="newTenant.SystemInstruction" rows="4" placeholder="Define the AI persona and rules..." />
                    <small class="text-muted">Instructions for the AI on how to behave for this client.</small>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label">Allowed Websites (CORS)</label>
                    <input type="text" class="form-control" @bind="allowedOriginsString" placeholder="https://example.com, https://another-site.com" />
                    <small class="text-muted">Comma-separated website origins. Include scheme, domain, and port when needed.</small>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label d-block">Enabled Channels</label>
                    <div class="form-check form-check-inline d-inline-block me-3">
                        <InputCheckbox id="isWebsiteChatbotEnabled" class="form-check-input" @bind-Value="newTenant.IsWebsiteChatbotEnabled" />
                        <label class="form-check-label ms-1" for="isWebsiteChatbotEnabled">Website Chatbot</label>
                    </div>
                    <div class="form-check form-check-inline d-inline-block">
                        <InputCheckbox id="isWhatsAppEnabled" class="form-check-input" @bind-Value="newTenant.IsWhatsAppEnabled" />
                        <label class="form-check-label ms-1" for="isWhatsAppEnabled">WhatsApp Integration</label>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <i class="@(isEditing ? "bi bi-check-circle" : "bi bi-check-lg") me-2"></i> 
                            <span>@(isEditing ? "Update Client" : "Create Client")</span>
                        }
                    </button>
                    
                    @if (isEditing)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
                            Cancel
                        </button>
                    }
                </div>
            </EditForm>

            @if (showSuccess)
            {
                <div class="alert alert-success mt-3">
                    <i class="bi bi-check-circle-fill me-2"></i> Client created successfully!
                </div>
            }
        </div>
    </div>

    <!-- Existing Clients List -->
    <div class="card">
        <div class="card-header">
            <h3><i class="bi bi-people-fill me-2"></i> Existing Clients</h3>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive client-list-scroll">
                <table class="table table-hover mb-0">
                    <thead class="sticky-top">
                        <tr>
                            <th>Name</th>
                            <th>Contact Info</th>
                            <th>Portal Login</th>
                            <th>Token Usage</th>
                            <th>Channels</th>
                            <th>Welcome Greeting</th>
                            <th>Allowed Origins</th>
                            <th>Integration Link</th>
                            <th style="width: 100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tenant in tenants)
                        {
                            <tr>
                                <td class="fw-bold">@tenant.Name</td>
                                <td>
                                    <div class="small">
                                        <div class="fw-semibold">@tenant.ContactEmail</div>
                                        <div class="text-muted">Max Tokens: @tenant.MaxTokensPerSession</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info">@GetClientUsername(tenant)</span>
                                </td>
                                <td>
                                    <div class="usage-cell">
                                        <div class="usage-top">
                                            <strong>@tenant.MonthlyTokenUsage.ToString("N0")</strong>
                                            <span>/ @tenant.MonthlyTokenLimit.ToString("N0")</span>
                                        </div>
                                        <div class="usage-bar">
                                            <span style="width: @GetUsagePercent(tenant)%"></span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (tenant.IsWebsiteChatbotEnabled)
                                    {
                                        <span class="badge bg-primary-subtle text-primary me-1"><i class="bi bi-chat-dots-fill"></i> Web</span>
                                    }
                                    @if (tenant.IsWhatsAppEnabled)
                                    {
                                        <span class="badge bg-success-subtle text-success"><i class="bi bi-whatsapp"></i> WhatsApp</span>
                                    }
                                    @if (!tenant.IsWebsiteChatbotEnabled && !tenant.IsWhatsAppEnabled)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">None</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 150px;" title="@tenant.WelcomeMessage">
                                        @tenant.WelcomeMessage
                                    </span>
                                </td>
                                <td>
                                    @if (tenant.AllowedOrigins != null && tenant.AllowedOrigins.Any())
                                    {
                                        <span class="text-sm text-muted">
                                            @string.Join(", ", tenant.AllowedOrigins.Take(2))
                                            @(tenant.AllowedOrigins.Count > 2 ? $" (+{tenant.AllowedOrigins.Count - 2} more)" : "")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">None</span>
                                    }
                                </td>
                                <td>
                                    <div class="input-group input-group-sm" style="max-width: 250px;">
                                        <input type="text" class="form-control" value="@GetEmbedScript(tenant.Id)" readonly />
                                        <button class="btn btn-outline-secondary" @onclick="() => CopyToClipboard(tenant.Id)" title="Copy Link">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditTenant(tenant)" title="Edit Client">
                                        <i class="bi bi-pencil-square me-1"></i> Edit
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!tenants.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">No clients found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div>

<style>
    .clients-page {
        gap: 0.9rem;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        margin-bottom: 0;
    }

    .header-content h1 {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
        color: var(--text-color);
        letter-spacing: -0.02em;
    }

    .content-grid {
        display: grid;
        grid-template-columns: minmax(360px, 0.9fr) minmax(0, 1.5fr);
        gap: 1.25rem;
        align-items: start;
    }

    /* Form Card Styles */
    .card {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-sm);
        transition: box-shadow 0.2s, border-color 0.2s;
    }

    .card:hover {
        box-shadow: var(--shadow-md);
    }

    .card-header {
        background: transparent;
        padding: 1rem 1.2rem;
        border-bottom: 1px solid var(--border-color);
    }

    .card-header h3 {
        font-size: 1rem;
        font-weight: 800;
        margin: 0;
        display: flex;
        align-items: center;
        color: var(--text-color);
    }

    .card-body {
        padding: 1.2rem;
    }

    .form-label {
        font-weight: 500;
        color: var(--text-color);
        margin-bottom: 0.4rem;
        font-size: 0.9rem;
    }

    .form-control {
        border-radius: var(--border-radius-sm);
        border: 1px solid var(--border-color);
        padding: 0.62rem 0.8rem;
        font-size: 0.95rem;
        transition: all 0.2s;
        background-color: var(--background-color);
    }

    .form-control:focus {
        border-color: var(--primary-light);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        background-color: #fff;
    }

    /* Table Styles */
    .table-responsive {
        border-radius: 0 0 var(--border-radius) var(--border-radius);
        overflow: hidden;
    }
    
    .client-list-scroll {
        max-height: calc(100vh - 236px);
        overflow-y: auto;
    }

    .table {
        margin-bottom: 0;
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .table th {
        background-color: var(--surface-hover);
        font-weight: 600;
        color: var(--text-muted);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--border-color);
        padding: 0.75rem 1rem;
        position: sticky;
        top: 0;
        z-index: 10;
        text-align: left;
    }

    .table td {
        padding: 0.95rem 1rem;
        vertical-align: middle;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-color);
        font-size: 0.95rem;
        background-color: var(--surface-color);
    }

    .table tr:last-child td {
        border-bottom: none;
    }

    .table tr:hover td {
        background-color: var(--surface-hover);
    }

    .input-group {
        box-shadow: var(--shadow-sm);
        border-radius: var(--border-radius-sm);
        overflow: hidden;
    }

    .input-group .form-control {
        background-color: var(--background-color);
        border: 1px solid var(--border-color);
        border-right: none;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .input-group .btn {
        border: 1px solid var(--border-color);
        border-left: none;
        background: var(--surface-color);
        color: var(--text-muted);
        transition: all 0.2s;
    }

    .input-group .btn:hover {
        background: var(--surface-hover);
        color: var(--primary-color);
    }

    .usage-cell {
        min-width: 150px;
    }

    .usage-top {
        display: flex;
        align-items: baseline;
        gap: 0.25rem;
        white-space: nowrap;
    }

    .usage-top strong {
        font-size: 0.92rem;
    }

    .usage-top span {
        color: var(--text-muted);
        font-size: 0.8rem;
    }

    .usage-bar {
        height: 6px;
        margin-top: 0.35rem;
        border-radius: 999px;
        background: #e2e8f0;
        overflow: hidden;
    }

    .usage-bar span {
        display: block;
        height: 100%;
        background: var(--primary-gradient);
    }

    @@media (max-width: 992px) {
        .content-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 720px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .heading-actions {
            justify-content: flex-start;
        }
    }
</style>

@code {
    private Tenant newTenant = new Tenant();
    private List<Tenant> tenants = new List<Tenant>();
    private Dictionary<Guid, string> clientUsernames = new();
    private bool showSuccess = false;
    private string errorMessage = string.Empty;
    private bool isEditing = false;
    private bool isProcessing = false;
    private string allowedOriginsString = "";
    private string clientUsername = "";
    private string clientPassword = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTenants();
    }

    private async Task LoadTenants()
    {
        using var context = DbFactory.CreateDbContext();
        tenants = await context.Tenants.IgnoreQueryFilters().OrderByDescending(t => t.CreatedAt).ToListAsync();
        var tenantIds = tenants.Select(t => t.TenantId).Where(t => !string.IsNullOrWhiteSpace(t)).ToList();
        var clientUsers = await context.AppUsers
            .IgnoreQueryFilters()
            .Where(u => u.Role == "Client" && tenantIds.Contains(u.TenantId))
            .OrderBy(u => u.CreatedAt)
            .ToListAsync();
        clientUsernames = clientUsers
            .Where(u => Guid.TryParse(u.TenantId, out _))
            .GroupBy(u => Guid.Parse(u.TenantId))
            .ToDictionary(g => g.Key, g => g.First().Username);
    }

    private async Task HandleValidSubmit()
    {
        if (isProcessing) return;
        isProcessing = true;
        showSuccess = false;
        errorMessage = string.Empty;

        var origins = allowedOriginsString
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(NormalizeOrigin)
            .Where(o => !string.IsNullOrWhiteSpace(o))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        try
        {
            using var context = DbFactory.CreateDbContext();

            if (string.IsNullOrWhiteSpace(newTenant.Name))
            {
                errorMessage = "Client name is required.";
                return;
            }

            clientUsername = clientUsername.Trim();
            if (string.IsNullOrWhiteSpace(clientUsername))
            {
                errorMessage = "Client portal username is required.";
                return;
            }

            if (!isEditing && string.IsNullOrWhiteSpace(clientPassword))
            {
                errorMessage = "Client portal password is required.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(newTenant.ContactEmail) &&
                !System.Net.Mail.MailAddress.TryCreate(newTenant.ContactEmail, out _))
            {
                errorMessage = "Enter a valid contact email address.";
                return;
            }

            if (newTenant.MaxTokensPerSession < 200 || newTenant.MaxTokensPerSession > 8000)
            {
                errorMessage = "Max response tokens must be between 200 and 8000.";
                return;
            }

            if (newTenant.MonthlyTokenLimit < 1000 || newTenant.MonthlyTokenLimit > 10000000)
            {
                errorMessage = "Monthly token limit must be between 1,000 and 10,000,000.";
                return;
            }

            if (origins.Any(origin => !IsValidOrigin(origin)))
            {
                errorMessage = "Allowed websites must be valid origins such as https://example.com.";
                return;
            }
            
            // Check for duplicate name
            bool nameExists;
            if (isEditing)
            {
                nameExists = await context.Tenants.IgnoreQueryFilters()
                    .AnyAsync(t => t.Name.ToLower() == newTenant.Name.ToLower() && t.Id != newTenant.Id);
            }
            else
            {
                nameExists = await context.Tenants.IgnoreQueryFilters()
                    .AnyAsync(t => t.Name.ToLower() == newTenant.Name.ToLower());
            }

            if (nameExists)
            {
                errorMessage = "A client with this name already exists. Please choose a different name.";
                return;
            }

            var tenantIdForLogin = isEditing ? newTenant.TenantId : newTenant.Id.ToString();
            var usernameExists = await context.AppUsers
                .IgnoreQueryFilters()
                .AnyAsync(u => u.Username.ToLower() == clientUsername.ToLower() && u.TenantId != tenantIdForLogin);
            if (usernameExists)
            {
                errorMessage = "This client portal username is already in use.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(newTenant.ContactEmail))
            {
                var emailExists = await context.AppUsers
                    .IgnoreQueryFilters()
                    .AnyAsync(u => u.Email.ToLower() == newTenant.ContactEmail.ToLower() && u.TenantId != tenantIdForLogin);
                if (emailExists)
                {
                    errorMessage = "This contact email is already used by another portal login.";
                    return;
                }
            }
            
            if (isEditing)
            {
                var existingTenant = await context.Tenants.IgnoreQueryFilters().FirstOrDefaultAsync(t => t.Id == newTenant.Id);
                if (existingTenant != null)
                {
                    existingTenant.Name = newTenant.Name;
                    existingTenant.ContactEmail = newTenant.ContactEmail;
                    existingTenant.ContactPhone = newTenant.ContactPhone;
                    existingTenant.WelcomeMessage = newTenant.WelcomeMessage;
                    existingTenant.MaxTokensPerSession = newTenant.MaxTokensPerSession;
                    existingTenant.MonthlyTokenLimit = newTenant.MonthlyTokenLimit;
                    existingTenant.SystemInstruction = newTenant.SystemInstruction;
                    existingTenant.AllowedOrigins = origins;
                    existingTenant.IsWebsiteChatbotEnabled = newTenant.IsWebsiteChatbotEnabled;
                    existingTenant.IsWhatsAppEnabled = newTenant.IsWhatsAppEnabled;
                    if (!await UpsertClientUser(context, existingTenant.TenantId, clientPassword))
                        return;
                    await context.SaveChangesAsync();
                }
            }
            else
            {
                newTenant.AllowedOrigins = origins;
                // Ensure ID is set if not already (should be handled by DB or ctor usually)
                if (newTenant.Id == Guid.Empty) newTenant.Id = Guid.NewGuid();
                newTenant.TenantId = newTenant.Id.ToString();
                
                context.Tenants.Add(newTenant);
                if (!await UpsertClientUser(context, newTenant.TenantId, clientPassword))
                    return;
                await context.SaveChangesAsync();
            }

            showSuccess = true;
            await LoadTenants();
            
            // Reset form but keep success message visible for a moment
            newTenant = new Tenant(); 
            allowedOriginsString = "";
            clientUsername = "";
            clientPassword = "";
            isEditing = false;
            
            // Hide success message after 3 seconds
            await Task.Delay(3000);
            showSuccess = false;
            StateHasChanged();
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void EditTenant(Tenant tenant)
    {
        // Create a copy to avoid modifying the list item directly before saving
        newTenant = new Tenant
        {
            Id = tenant.Id,
            Name = tenant.Name,
            ContactEmail = tenant.ContactEmail,
            ContactPhone = tenant.ContactPhone,
            WelcomeMessage = tenant.WelcomeMessage,
            MaxTokensPerSession = tenant.MaxTokensPerSession,
            MonthlyTokenLimit = tenant.MonthlyTokenLimit,
            MonthlyTokenUsage = tenant.MonthlyTokenUsage,
            TokenUsageMonthStartedAt = tenant.TokenUsageMonthStartedAt,
            SystemInstruction = tenant.SystemInstruction,
            CreatedAt = tenant.CreatedAt,
            KnowledgeBaseText = tenant.KnowledgeBaseText,
            TenantId = tenant.TenantId,
            IsWebsiteChatbotEnabled = tenant.IsWebsiteChatbotEnabled,
            IsWhatsAppEnabled = tenant.IsWhatsAppEnabled
        };
        
        allowedOriginsString = tenant.AllowedOrigins != null 
            ? string.Join(", ", tenant.AllowedOrigins) 
            : "";
        clientUsername = GetClientUsername(tenant);
        clientPassword = "";
            
        isEditing = true;
        showSuccess = false;
        errorMessage = string.Empty;
    }

    private void CancelEdit()
    {
        newTenant = new Tenant();
        allowedOriginsString = "";
        clientUsername = "";
        clientPassword = "";
        isEditing = false;
        showSuccess = false;
        errorMessage = string.Empty;
    }



    private async Task CopyToClipboard(Guid tenantId)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", GetEmbedScript(tenantId));
    }

    private string GetChatbotPublicUrl()
    {
        var configuredUrl = Configuration["Chatbot:PublicUrl"];
        if (!string.IsNullOrWhiteSpace(configuredUrl))
            return configuredUrl.TrimEnd('/');

        return Navigation.BaseUri.TrimEnd('/');
    }

    private string GetEmbedScript(Guid tenantId)
    {
        var publicUrl = GetChatbotPublicUrl();
        return $"<script src=\"{publicUrl}/assets/index.js\" data-tenant-id=\"{tenantId}\" data-api-url=\"{publicUrl}\" defer></script>";
    }

    private async Task<bool> UpsertClientUser(HattieDbContext context, string tenantId, string password)
    {
        var user = await context.AppUsers
            .IgnoreQueryFilters()
            .FirstOrDefaultAsync(u => u.Role == "Client" && u.TenantId == tenantId);

        if (user == null)
        {
            if (string.IsNullOrWhiteSpace(password))
            {
                errorMessage = "Set a password for the client portal login.";
                return false;
            }

            context.AppUsers.Add(new AppUser
            {
                Id = Guid.NewGuid(),
                Username = clientUsername,
                Email = newTenant.ContactEmail,
                PasswordHash = PasswordSecurity.HashPassword(password),
                Role = "Client",
                TenantId = tenantId
            });
            return true;
        }

        user.Username = clientUsername;
        user.Email = newTenant.ContactEmail;
        user.Role = "Client";
        user.TenantId = tenantId;

        if (!string.IsNullOrWhiteSpace(password))
            user.PasswordHash = PasswordSecurity.HashPassword(password);

        return true;
    }

    private string GetClientUsername(Tenant tenant)
    {
        return clientUsernames.TryGetValue(tenant.Id, out var username) ? username : "Not set";
    }

    private static int GetUsagePercent(Tenant tenant)
    {
        if (tenant.MonthlyTokenLimit <= 0)
            return 100;

        return Math.Clamp((int)Math.Round(tenant.MonthlyTokenUsage * 100d / tenant.MonthlyTokenLimit), 0, 100);
    }

    private static string NormalizeOrigin(string origin)
    {
        return origin.Trim().TrimEnd('/');
    }

    private static bool IsValidOrigin(string origin)
    {
        if (origin == "*")
            return false;

        return Uri.TryCreate(origin, UriKind.Absolute, out var uri) &&
               (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps) &&
               !string.IsNullOrWhiteSpace(uri.Host) &&
               string.IsNullOrWhiteSpace(uri.PathAndQuery.Trim('/'));
    }
}
