@page "/clients"
@using HattieAI.Domain.Entities
@using HattieAI.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDbContextFactory<HattieDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Clients | Hattie AI</PageTitle>

<div class="page-header">
    <div class="header-content">
        <h1>Client Management</h1>
        <p class="text-muted">Onboard new clients and manage existing integrations.</p>
    </div>
</div>

<div class="content-grid">
    <!-- Create Client Card -->
    <div class="card">
        <div class="card-header">
            <h3>
                <i class="@(isEditing ? "bi bi-pencil-square" : "bi bi-person-plus-fill") me-2"></i> 
                @(isEditing ? "Edit Client" : "Onboard New Client")
            </h3>
        </div>
        <div class="card-body">
            <EditForm Model="@newTenant" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                    </div>
                }

                <div class="form-group mb-3">
                    <label class="form-label">Client Name</label>
                    <InputText class="form-control" @bind-Value="newTenant.Name" placeholder="e.g. Acme Corp" />
                </div>

                <div class="form-group mb-4">
                    <label class="form-label">System Instruction</label>
                    <InputTextArea class="form-control" @bind-Value="newTenant.SystemInstruction" rows="4" placeholder="Define the AI persona and rules..." />
                    <small class="text-muted">Instructions for the AI on how to behave for this client.</small>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label">Allowed Websites (CORS)</label>
                    <input type="text" class="form-control" @bind="allowedOriginsString" placeholder="https://example.com, https://another-site.com" />
                    <small class="text-muted">Comma-separated list of websites where this chatbot will be embedded.</small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <i class="@(isEditing ? "bi bi-check-circle" : "bi bi-check-lg") me-2"></i> 
                            <span>@(isEditing ? "Update Client" : "Create Client")</span>
                        }
                    </button>
                    
                    @if (isEditing)
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
                            Cancel
                        </button>
                    }
                </div>
            </EditForm>

            @if (showSuccess)
            {
                <div class="alert alert-success mt-3">
                    <i class="bi bi-check-circle-fill me-2"></i> Client created successfully!
                </div>
            }
        </div>
    </div>

    <!-- Existing Clients List -->
    <div class="card">
        <div class="card-header">
            <h3><i class="bi bi-people-fill me-2"></i> Existing Clients</h3>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive client-list-scroll">
                <table class="table table-hover mb-0">
                    <thead class="sticky-top">
                        <tr>
                            <th>Name</th>
                            <th>Integration Link</th>
                            <th>Allowed Origins</th>
                            <th style="width: 120px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tenant in tenants)
                        {
                            <tr>
                                <td class="fw-bold">@tenant.Name</td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control" value="https://localhost:5173/?tenantId=@tenant.Id" readonly />
                                        <button class="btn btn-outline-secondary" @onclick="() => CopyToClipboard(tenant.Id)" title="Copy Link">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    @if (tenant.AllowedOrigins != null && tenant.AllowedOrigins.Any())
                                    {
                                        <small class="text-muted">
                                            @string.Join(", ", tenant.AllowedOrigins.Take(2))
                                            @(tenant.AllowedOrigins.Count > 2 ? $" (+{tenant.AllowedOrigins.Count - 2} more)" : "")
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">None</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="() => EditTenant(tenant)" title="Edit Client">
                                        <i class="bi bi-pencil-square me-1"></i> Edit
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!tenants.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">No clients found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .page-header {
        margin-bottom: 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-content h1 {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
        color: var(--text-color);
        letter-spacing: -0.02em;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 2rem;
        align-items: start;
    }

    /* Form Card Styles */
    .card {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-sm);
        transition: box-shadow 0.2s;
    }

    .card:hover {
        box-shadow: var(--shadow-md);
    }

    .card-header {
        background: transparent;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
    }

    .card-header h3 {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        color: var(--text-color);
    }

    .card-body {
        padding: 1.5rem;
    }

    .form-label {
        font-weight: 500;
        color: var(--text-color);
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }

    .form-control {
        border-radius: var(--border-radius-sm);
        border: 1px solid var(--border-color);
        padding: 0.6rem 0.8rem;
        font-size: 0.95rem;
        transition: all 0.2s;
        background-color: var(--background-color);
    }

    .form-control:focus {
        border-color: var(--primary-light);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        background-color: #fff;
    }

    /* Table Styles */
    .table-responsive {
        border-radius: 0 0 var(--border-radius) var(--border-radius);
        overflow: hidden;
    }
    
    .client-list-scroll {
        max-height: calc(100vh - 250px);
        overflow-y: auto;
    }

    .table {
        margin-bottom: 0;
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .table th {
        background-color: var(--surface-hover);
        font-weight: 600;
        color: var(--text-muted);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--border-color);
        padding: 0.75rem 1.5rem;
        position: sticky;
        top: 0;
        z-index: 10;
        text-align: left;
    }

    .table td {
        padding: 1rem 1.5rem;
        vertical-align: middle;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-color);
        font-size: 0.95rem;
        background-color: var(--surface-color);
    }

    .table tr:last-child td {
        border-bottom: none;
    }

    .table tr:hover td {
        background-color: var(--surface-hover);
    }

    .input-group {
        box-shadow: var(--shadow-sm);
        border-radius: var(--border-radius-sm);
        overflow: hidden;
    }

    .input-group .form-control {
        background-color: var(--background-color);
        border: 1px solid var(--border-color);
        border-right: none;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
        color: var(--text-muted);
    }

    .input-group .btn {
        border: 1px solid var(--border-color);
        border-left: none;
        background: var(--surface-color);
        color: var(--text-muted);
        transition: all 0.2s;
    }

    .input-group .btn:hover {
        background: var(--surface-hover);
        color: var(--primary-color);
    }

    @@media (max-width: 992px) {
        .content-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private Tenant newTenant = new Tenant();
    private List<Tenant> tenants = new List<Tenant>();
    private bool showSuccess = false;
    private string errorMessage = string.Empty;
    private bool isEditing = false;
    private bool isProcessing = false;
    private string allowedOriginsString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTenants();
    }

    private async Task LoadTenants()
    {
        using var context = DbFactory.CreateDbContext();
        tenants = await context.Tenants.IgnoreQueryFilters().OrderByDescending(t => t.CreatedAt).ToListAsync();
    }

    private async Task HandleValidSubmit()
    {
        if (isProcessing) return;
        isProcessing = true;
        showSuccess = false;
        errorMessage = string.Empty;

        // Parse allowed origins
        var origins = allowedOriginsString
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(o => o.Trim())
            .Where(o => !string.IsNullOrWhiteSpace(o))
            .ToList();

        try
        {
            using var context = DbFactory.CreateDbContext();
            
            // Check for duplicate name
            bool nameExists;
            if (isEditing)
            {
                nameExists = await context.Tenants.IgnoreQueryFilters()
                    .AnyAsync(t => t.Name.ToLower() == newTenant.Name.ToLower() && t.Id != newTenant.Id);
            }
            else
            {
                nameExists = await context.Tenants.IgnoreQueryFilters()
                    .AnyAsync(t => t.Name.ToLower() == newTenant.Name.ToLower());
            }

            if (nameExists)
            {
                errorMessage = "A client with this name already exists. Please choose a different name.";
                return;
            }
            
            if (isEditing)
            {
                var existingTenant = await context.Tenants.IgnoreQueryFilters().FirstOrDefaultAsync(t => t.Id == newTenant.Id);
                if (existingTenant != null)
                {
                    existingTenant.Name = newTenant.Name;
                    existingTenant.SystemInstruction = newTenant.SystemInstruction;
                    existingTenant.AllowedOrigins = origins;
                    await context.SaveChangesAsync();
                }
            }
            else
            {
                newTenant.AllowedOrigins = origins;
                // Ensure ID is set if not already (should be handled by DB or ctor usually)
                if (newTenant.Id == Guid.Empty) newTenant.Id = Guid.NewGuid();
                newTenant.TenantId = newTenant.Id.ToString();
                
                context.Tenants.Add(newTenant);
                await context.SaveChangesAsync();
            }

            showSuccess = true;
            await LoadTenants();
            
            // Reset form but keep success message visible for a moment
            newTenant = new Tenant(); 
            allowedOriginsString = "";
            isEditing = false;
            
            // Hide success message after 3 seconds
            await Task.Delay(3000);
            showSuccess = false;
            StateHasChanged();
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void EditTenant(Tenant tenant)
    {
        // Create a copy to avoid modifying the list item directly before saving
        newTenant = new Tenant
        {
            Id = tenant.Id,
            Name = tenant.Name,
            SystemInstruction = tenant.SystemInstruction,
            CreatedAt = tenant.CreatedAt,
            KnowledgeBaseText = tenant.KnowledgeBaseText,
            TenantId = tenant.TenantId
        };
        
        allowedOriginsString = tenant.AllowedOrigins != null 
            ? string.Join(", ", tenant.AllowedOrigins) 
            : "";
            
        isEditing = true;
        showSuccess = false;
        errorMessage = string.Empty;
    }

    private void CancelEdit()
    {
        newTenant = new Tenant();
        allowedOriginsString = "";
        isEditing = false;
        showSuccess = false;
        errorMessage = string.Empty;
    }



    private async Task CopyToClipboard(Guid tenantId)
    {
        var runUrl = $"https://localhost:5173/?tenantId={tenantId}";
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", runUrl);
    }
}
