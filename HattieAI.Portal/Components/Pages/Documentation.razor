@page "/documentation"
@using HattieAI.Domain.Entities
@using HattieAI.Infrastructure.Persistence
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject IDbContextFactory<HattieDbContext> DbFactory
@inject IConfiguration Configuration
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Documentation | Hattie AI</PageTitle>

<div class="portal-page docs-page">
    <div class="page-heading">
        <div>
            <h1>Documentation</h1>
            @if (isAdmin)
            {
                <p>Operational guide for installing Hattie, configuring clients, languages, websites, and knowledge sources.</p>
            }
            else
            {
                <p>Learn how to embed Hattie chatbot on your website, set up WhatsApp automation, and manage your knowledge base.</p>
            }
        </div>
        <div class="heading-actions">
            @if (isAdmin)
            {
                <span class="metric-pill">@tenants.Count clients</span>
            }
            else
            {
                <span class="metric-pill">Client: @selectedTenant?.Name</span>
            }
            <span class="metric-pill">@chatbotPublicUrl</span>
        </div>
    </div>

    @if (!isAdmin && selectedTenant?.IsWebsiteChatbotEnabled != true && selectedTenant?.IsWhatsAppEnabled != true)
    {
        <div class="state-panel">
            <i class="bi bi-file-earmark-text"></i>
            <strong>Documentation is not enabled</strong>
            <span>Your client account does not have chatbot services enabled.</span>
        </div>
    }
    else
    {
    <div class="docs-layout">
        <aside class="docs-toc">
            <button type="button" @onclick='() => ScrollToSection("quick-start")'>Quick Start</button>
            @if (isAdmin || selectedTenant?.IsWebsiteChatbotEnabled == true)
            {
                <button type="button" @onclick='() => ScrollToSection("embed")'>Website Embed</button>
                <button type="button" @onclick='() => ScrollToSection("nextjs")'>Next.js</button>
                <button type="button" @onclick='() => ScrollToSection("wordpress")'>WordPress</button>
            }
            @if (isAdmin || selectedTenant?.IsWhatsAppEnabled == true)
            {
                <button type="button" @onclick='() => ScrollToSection("whatsapp-config")'>WhatsApp Setup</button>
            }
            @if (isAdmin || selectedTenant?.IsWebsiteChatbotEnabled == true)
            {
                <button type="button" @onclick='() => ScrollToSection("origins")'>Allowed Websites</button>
            }
            <button type="button" @onclick='() => ScrollToSection("languages")'>Languages</button>
            <button type="button" @onclick='() => ScrollToSection("knowledge")'>Knowledge Base</button>
            <button type="button" @onclick='() => ScrollToSection("crm-docs")'>CRM & Lead Collection</button>
            <button type="button" @onclick='() => ScrollToSection("api-docs")'>API Integrations</button>
            <button type="button" @onclick='() => ScrollToSection("session-docs")'>Session Management</button>
            @if (isAdmin)
            {
                <button type="button" @onclick='() => ScrollToSection("developer-docs")'>Developer & Debugging</button>
            }
            <button type="button" @onclick='() => ScrollToSection("troubleshooting")'>Troubleshooting</button>
        </aside>

        <main class="docs-content">
            <section id="quick-start" class="doc-section">
                <div class="doc-section-header">
                    <span class="doc-kicker">Start Here</span>
                    <h2>Quick Start</h2>
                </div>
                <div class="step-grid">
                    @if (isAdmin)
                    {
                        <div class="step-card">
                            <strong>1. Create Client</strong>
                            <span>Add client name, support email, welcome message, and AI instruction in Clients.</span>
                        </div>
                        <div class="step-card">
                            <strong>2. Configure Access</strong>
                            <span>Select languages and add allowed website origins in Configuration.</span>
                        </div>
                        <div class="step-card">
                            <strong>3. Add Knowledge</strong>
                            <span>Upload PDFs or paste verified text in Knowledge Base.</span>
                        </div>
                        <div class="step-card">
                            <strong>4. Install Script</strong>
                            <span>Copy the embed snippet into the website before the closing body tag.</span>
                        </div>
                    }
                    else
                    {
                        <div class="step-card">
                            <strong>1. Configure Access</strong>
                            <span>Manage languages and allowed website origins in Configuration.</span>
                        </div>
                        <div class="step-card">
                            <strong>2. Add Knowledge</strong>
                            <span>Upload PDFs or paste verified text in Knowledge Base to teach your chatbot.</span>
                        </div>
                        <div class="step-card">
                            <strong>3. Install Widget</strong>
                            <span>Copy the website embed HTML snippet and paste it into your site's code.</span>
                        </div>
                        <div class="step-card">
                            <strong>4. Setup WhatsApp</strong>
                            <span>Connect your Meta Business WhatsApp API in WhatsApp Setup to auto-reply to users.</span>
                        </div>
                    }
                </div>
            </section>

            @if (isAdmin || selectedTenant?.IsWebsiteChatbotEnabled == true)
            {
                <section id="embed" class="doc-section">
                    <div class="doc-section-header">
                        <span class="doc-kicker">Website Install</span>
                        <h2>Standard HTML, React, Vue, and Most Sites</h2>
                        <p>Use this for normal websites and single-page apps. The tenant ID can come from the copied client snippet or from the client table.</p>
                    </div>

                    <div class="snippet-toolbar">
                        @if (isAdmin)
                        {
                            <select class="form-select" @bind="selectedTenantId" @bind:after="UpdateSnippets">
                                <option value="">Use placeholder tenant</option>
                                @foreach (var tenant in tenants)
                                {
                                    <option value="@tenant.Id">@tenant.Name</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="selected-client-readonly">
                                <i class="bi bi-building"></i>
                                <span>@selectedTenant?.Name</span>
                            </div>
                        }
                        <button class="btn btn-outline-primary" @onclick="() => CopyToClipboard(standardSnippet)">Copy HTML Snippet</button>
                    </div>

                    <pre class="code-block"><code>@standardSnippet</code></pre>

                    <div class="doc-note">
                        <i class="bi bi-info-circle"></i>
                        <span>The script supports <code>data-tenant-id</code> and <code>data-api-url</code>. This is the preferred install format because it avoids extra global script setup.</span>
                    </div>
                </section>

                <section id="nextjs" class="doc-section">
                    <div class="doc-section-header">
                        <span class="doc-kicker">Framework</span>
                        <h2>Next.js App Router</h2>
                        <p>Add this to <code>app/layout.tsx</code>. Load CSS in <code>head</code> and the chatbot script after the page becomes interactive.</p>
                    </div>
                    <button class="btn btn-outline-primary btn-sm mb-2" @onclick="() => CopyToClipboard(nextJsSnippet)">Copy Next.js Snippet</button>
                    <pre class="code-block"><code>@nextJsSnippet</code></pre>
                </section>

                <section id="wordpress" class="doc-section">
                    <div class="doc-section-header">
                        <span class="doc-kicker">CMS</span>
                        <h2>WordPress</h2>
                        <p>Use a header/footer code plugin or add the function to the active theme's <code>functions.php</code>.</p>
                    </div>
                    <button class="btn btn-outline-primary btn-sm mb-2" @onclick="() => CopyToClipboard(wordPressSnippet)">Copy WordPress Snippet</button>
                    <pre class="code-block"><code>@wordPressSnippet</code></pre>
                </section>
            }

            @if (isAdmin || selectedTenant?.IsWhatsAppEnabled == true)
            {
                <section id="whatsapp-config" class="doc-section">
                    <div class="doc-section-header">
                        <span class="doc-kicker">WhatsApp Suite</span>
                        <h2>WhatsApp Setup & Meta Configuration</h2>
                        <p>Follow these steps to connect your WhatsApp Business API and start automating conversations.</p>
                    </div>

                    <div class="rule-list">
                        <div>
                            <strong>1. Meta Developer Registration</strong>
                            <span>Sign up for a developer account at <a href="https://developers.facebook.com/" target="_blank">Meta for Developers</a> and create a Business App. Add the <strong>WhatsApp</strong> product to your app.</span>
                        </div>
                        <div>
                            <strong>2. Retrieve API Credentials</strong>
                            <span>Navigate to <strong>WhatsApp > API Setup</strong> in the Meta Dashboard. Retrieve your <strong>Phone Number ID</strong> and generate a permanent <strong>System User Access Token</strong>.</span>
                        </div>
                        <div>
                            <strong>3. Save to Hattie Portal</strong>
                            <span>Go to the <a href="whatsapp-setup">WhatsApp Setup</a> tab in the Hattie sidebar. Enter your <strong>Phone Number ID</strong> and <strong>Access Token</strong>. Select/generate a secure <strong>Webhook Verify Token</strong> of your choice and click <strong>Save Configuration</strong>.</span>
                        </div>
                        <div>
                            <strong>4. Setup Meta Webhooks</strong>
                            <span>In the Meta Developer Console, go to <strong>WhatsApp > Configuration</strong>. Click Edit next to Webhooks. Paste the following URL as your Callback URL: <br />
                            <code class="font-monospace text-xs">@webhookUrl</code> <br />
                            Enter the exact same <strong>Verify Token</strong> you chose in Step 3. Click <strong>Verify and Save</strong>.</span>
                        </div>
                        <div>
                            <strong>5. Subscribe to Message Webhooks</strong>
                            <span>On the same Meta Configuration page, click <strong>Manage</strong> next to Webhook Fields. Click <strong>Subscribe</strong> for the <strong>messages</strong> row. This is critical for Hattie to receive user queries!</span>
                        </div>
                    </div>
                </section>
            }

            @if (isAdmin || selectedTenant?.IsWebsiteChatbotEnabled == true)
            {
                <section id="origins" class="doc-section">
                    <div class="doc-section-header">
                        <span class="doc-kicker">Security</span>
                        <h2>Allowed Websites</h2>
                        <p>Allowed origins control which websites can connect to the chatbot API for a client.</p>
                    </div>
                    <div class="rule-list">
                        <div><strong>Use origins only.</strong><span>Correct: <code>https://example.com</code>. Wrong: <code>https://example.com/page</code>.</span></div>
                        <div><strong>Include ports for staging.</strong><span>Example: <code>https://staging.example.com:8443</code>.</span></div>
                        <div><strong>Add production before launch.</strong><span>If no website is configured, local development may work but external usage should be treated as incomplete setup.</span></div>
                        <div><strong>Subdomains are supported.</strong><span>An allowed root host can match subdomains in API CORS matching.</span></div>
                    </div>
                </section>
            }

            <section id="languages" class="doc-section">
                <div class="doc-section-header">
                    <span class="doc-kicker">Localization</span>
                    <h2>Languages</h2>
                    <p>Languages visible in the chatbot are controlled per client in Configuration.</p>
                </div>
                <div class="rule-list">
                    <div><strong>Enable per client.</strong><span>Select only the languages the client wants visitors to use.</span></div>
                    <div><strong>Response language follows selection.</strong><span>The API instructs the AI to reply in the chosen language.</span></div>
                    @if (isAdmin)
                    {
                        <div><strong>Adding new languages needs code and DB seed.</strong><span>Add the language in <code>HattieDbContext.cs</code>, create a migration, and add chatbot UI labels in <code>ChatInterface.tsx</code>.</span></div>
                        <div><strong>Recommended baseline.</strong><span>Use Core languages first: English, Hindi, Arabic, Spanish, and French.</span></div>
                    }
                    else
                    {
                        <div><strong>Supported languages.</strong><span>Any selected language allows the chatbot to translate and chat with visitors in that language natively.</span></div>
                    }
                </div>

                @if (isAdmin)
                {
                    <pre class="code-block"><code>@languageMigrationSnippet</code></pre>
                }
            </section>

            <section id="knowledge" class="doc-section">
                <div class="doc-section-header">
                    <span class="doc-kicker">Retrieval</span>
                    <h2>Knowledge Base</h2>
                    <p>Hattie answers business-specific questions from each client's knowledge. Keep this content factual and current.</p>
                </div>
                <div class="rule-list">
                    <div><strong>Supported input.</strong><span>PDF upload and pasted text are supported in the portal.</span></div>
                    <div><strong>Use source labels.</strong><span>Label uploads like <code>Pricing Sheet Jan 2026</code> so future admins can audit the content.</span></div>
                    <div><strong>Append for incremental updates.</strong><span>Use Append when adding a new source. Use Replace when the old knowledge is obsolete.</span></div>
                    <div><strong>Chunks rebuild automatically.</strong><span>Every save rebuilds retrieval chunks for that client.</span></div>
                    <div><strong>Do not upload unverified content.</strong><span>The chatbot is instructed to answer only from available context for client-specific questions.</span></div>
                </div>
            </section>

            <section id="crm-docs" class="doc-section">
                <div class="doc-section-header">
                    <span class="doc-kicker">Leads</span>
                    <h2>CRM & Lead Collection</h2>
                    <p>Hattie AI collects customer details natively during website and WhatsApp chats, organizing them into a Kanban board.</p>
                </div>
                <div class="rule-list">
                    <div>
                        <strong>How Lead Collection Works</strong>
                        <span>When a customer interacts with the bot, the AI extracts details like name, email, phone, company, and interest notes as the conversation progresses, and automatically creates a lead in the CRM.</span>
                    </div>
                    <div>
                        <strong>Configure Lead Instructions</strong>
                        <span>Under the <strong>Configuration</strong> page, you can enable/disable lead collection and specify instructions for the AI (e.g., <em>"Ask the user for their email and phone number before discussing booking options"</em>).</span>
                    </div>
                    <div>
                        <strong>Managing the Kanban Board</strong>
                        <span>The CRM page features a Kanban board with stages: <em>New, Contacted, Qualified, Proposal, Won, and Lost</em>. You can move cards using the left/right arrows, view the original conversation history, edit lead details, or manually add offline leads.</span>
                    </div>
                </div>
            </section>

            <section id="api-docs" class="doc-section">
                <div class="doc-section-header">
                    <span class="doc-kicker">Integrations</span>
                    <h2>API Integrations</h2>
                    <p>Connect third-party APIs to allow the AI to push or pull data during conversations dynamically.</p>
                </div>
                <div class="rule-list">
                    <div>
                        <strong>Overview</strong>
                        <span>API integrations let the AI run live actions—such as checking order status, booking appointments, or submitting leads to an external database—in real time.</span>
                    </div>
                    <div>
                        <strong>Push vs Pull</strong>
                        <span><strong>Push</strong> integrations send data to external systems. <strong>Pull</strong> integrations fetch data to answer customer questions dynamically (e.g., stock levels, prices).</span>
                    </div>
                    <div>
                        <strong>Integration Setup</strong>
                        <span>Specify the HTTP Method, Endpoint URL, extra Headers, and Authentication details (ApiKey, Bearer Token, or Basic). Custom templates let you map AI-extracted parameters using the <code>@("{{")</code>parameter_name<code>@("}}")</code> syntax in the request body.</span>
                    </div>
                    <div>
                        <strong>Testing API Connection</strong>
                        <span>Use the <strong>Test</strong> (play) button on any API card to run a manual check with mock parameters. This shows response status and payloads for easy validation.</span>
                    </div>
                </div>
            </section>

            <section id="session-docs" class="doc-section">
                <div class="doc-section-header">
                    <span class="doc-kicker">Sessions</span>
                    <h2>Session Management & Timeout</h2>
                    <p>Understand how chat session lifetimes are managed for privacy and stability.</p>
                </div>
                <div class="rule-list">
                    <div>
                        <strong>Website Chat Widget</strong>
                        <span>A website visitor's chat session automatically expires and clears after 10 minutes of inactivity, or when they refresh the browser page. This ensures customer privacy on public devices.</span>
                    </div>
                    <div>
                        <strong>WhatsApp Automation</strong>
                        <span>A WhatsApp contact's active session closes automatically after 10 minutes of inactivity. When timed out, the system sends an automatic thank you message. A new session starts on their next message.</span>
                    </div>
                </div>
            </section>

            @if (isAdmin)
            {
                <section id="developer-docs" class="doc-section">
                    <div class="doc-section-header">
                        <span class="doc-kicker">Developer Specs</span>
                        <h2>Developer & Debugging Guide</h2>
                        <p>Internal documentation for platform administrators and system developers.</p>
                    </div>
                    <div class="rule-list">
                        <div>
                            <strong>Core API Routing & LLM Evaluation</strong>
                            <span>The <code>ApiExecutionService</code> evaluates current active integrations by passing schemas to the LLM (Groq/Gemini). It extracts parameters in JSON format and calls endpoints. All exceptions are handled gracefully; the user never sees raw backend failures.</span>
                        </div>
                        <div>
                            <strong>Credential Encryption (AES-256)</strong>
                            <span>Tokens and secrets are encrypted at rest using AES-256. Ensure a secure <code>ENCRYPTION_KEY</code> environment variable is set. If the key is missing or modified, decryption of saved credentials will fail.</span>
                        </div>
                        <div>
                            <strong>WhatsApp Background Timeout Service</strong>
                            <span>WhatsApp session timeouts are checked by a background worker (<code>WhatsAppSessionTimeoutService</code>) inheriting from <code>BackgroundService</code>. It runs every minute, scanning for sessions with no activity for 10 minutes, triggers a thank-you message via Meta API, and marks them closed.</span>
                        </div>
                        <div>
                            <strong>Database Schema & Seed Files</strong>
                            <span>Database models are located in <code>HattieAI.Domain/Entities</code>. Any schema change requires creating EF Migrations targeted to the PostgreSQL database. The startup projects execute migrations automatically.</span>
                        </div>
                        <div>
                            <strong>Debugging Integrations & Logs</strong>
                            <span>Check console/syslog outputs for <code>[ApiExecutionService]</code> prefix. Test payloads, endpoint connection errors, rate limit indicators, and JSON parsing failures are logged there.</span>
                        </div>
                    </div>
                </section>
            }

            <section id="troubleshooting" class="doc-section">
                <div class="doc-section-header">
                    <span class="doc-kicker">Support</span>
                    <h2>Troubleshooting</h2>
                </div>
                <div class="troubleshooting-grid">
                    @if (isAdmin || selectedTenant?.IsWebsiteChatbotEnabled == true)
                    {
                        <div>
                            <strong>Chatbot does not appear</strong>
                            <span>Check the script URL, tenant ID, browser console, and whether <code>assets/index.css</code> and <code>assets/index.js</code> load successfully.</span>
                        </div>
                        <div>
                            <strong>Chat connects locally but not on website</strong>
                            <span>Add the website origin under Configuration and confirm <code>data-api-url</code> points to the public API URL.</span>
                        </div>
                    }
                    <div>
                        <strong>Language does not show</strong>
                        <span>Confirm the language is enabled for the selected client and exists in the seeded language table.</span>
                    </div>
                    <div>
                        <strong>Answers are incomplete</strong>
                        <span>Upload or paste better client knowledge, then save so chunks rebuild.</span>
                    </div>
                </div>
            </section>
        </main>
    </div>
    }
</div>
<style>
    .docs-layout {
        display: grid;
        grid-template-columns: 240px minmax(0, 1fr);
        gap: 1.25rem;
        align-items: start;
    }

    .docs-toc {
        position: sticky;
        top: 0;
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-sm);
        padding: 0.75rem;
        display: grid;
        gap: 0.25rem;
    }

    .docs-toc button {
        appearance: none;
        border: 0;
        background: transparent;
        color: var(--text-muted);
        text-decoration: none;
        border-radius: 8px;
        padding: 0.65rem 0.75rem;
        font-weight: 800;
        font-size: 0.9rem;
        text-align: left;
    }

    .docs-toc button:hover,
    .docs-toc button:focus-visible {
        background: #eff6ff;
        color: var(--primary-dark);
        outline: none;
    }

    .docs-content {
        display: grid;
        gap: 1rem;
        min-width: 0;
    }

    .doc-section {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-sm);
        padding: 1.25rem;
        scroll-margin-top: 1rem;
    }

    .doc-section-header {
        margin-bottom: 1rem;
    }

    .doc-kicker {
        display: inline-flex;
        color: var(--primary-dark);
        background: #eff6ff;
        border-radius: 999px;
        padding: 0.2rem 0.55rem;
        font-size: 0.72rem;
        font-weight: 800;
        margin-bottom: 0.45rem;
    }

    .doc-section h2 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--text-color);
    }

    .doc-section p {
        margin: 0.35rem 0 0;
        color: var(--text-muted);
    }

    .step-grid,
    .troubleshooting-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
    }

    .step-card,
    .troubleshooting-grid div,
    .rule-list div {
        border: 1px solid var(--border-color);
        background: #f8fafc;
        border-radius: 8px;
        padding: 0.9rem;
    }

    .step-card strong,
    .troubleshooting-grid strong,
    .rule-list strong {
        display: block;
        color: var(--text-color);
        font-weight: 800;
        margin-bottom: 0.25rem;
    }

    .step-card span,
    .troubleshooting-grid span,
    .rule-list span {
        color: var(--text-muted);
    }

    .snippet-toolbar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.75rem;
        align-items: center;
        margin-bottom: 0.75rem;
    }

    .selected-client-readonly {
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: #f8fafc;
        color: var(--text-color);
        display: flex;
        align-items: center;
        gap: 0.55rem;
        min-height: 42px;
        padding: 0.55rem 0.75rem;
        font-weight: 800;
    }

    .code-block {
        margin: 0;
        background: #0f172a;
        color: #e2e8f0;
        border-radius: 8px;
        padding: 1rem;
        overflow: auto;
        font-family: 'JetBrains Mono', Consolas, monospace;
        font-size: 0.84rem;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .doc-note {
        display: grid;
        grid-template-columns: 22px 1fr;
        gap: 0.6rem;
        align-items: start;
        margin-top: 0.85rem;
        border: 1px solid #bfdbfe;
        background: #eff6ff;
        color: #1e3a8a;
        border-radius: 8px;
        padding: 0.85rem;
    }

    .rule-list {
        display: grid;
        gap: 0.65rem;
    }

    @@media (max-width: 980px) {
        .docs-layout {
            grid-template-columns: 1fr;
        }

        .docs-toc {
            position: static;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 680px) {
        .step-grid,
        .troubleshooting-grid,
        .snippet-toolbar,
        .docs-toc {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private List<Tenant> tenants = new();
    private string chatbotPublicUrl = "";
    private string selectedTenantId = "";
    private string standardSnippet = "";
    private string nextJsSnippet = "";
    private string wordPressSnippet = "";
    private string languageMigrationSnippet = "";
    private bool isAdmin;
    private string currentTenantId = string.Empty;
    private Tenant? selectedTenant;
    private string webhookUrl = "";

    protected override async Task OnInitializedAsync()
    {
        chatbotPublicUrl = (Configuration["Chatbot:PublicUrl"] ?? NavigationFallback()).TrimEnd('/');
        webhookUrl = $"{Navigation.BaseUri.TrimEnd('/')}/api/whatsapp/webhook";
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");
        currentTenantId = user.FindFirst("TenantId")?.Value ?? string.Empty;

        using var context = DbFactory.CreateDbContext();
        var tenantsQuery = context.Tenants.IgnoreQueryFilters();
        tenants = await (isAdmin ? tenantsQuery : tenantsQuery.Where(t => t.TenantId == currentTenantId || t.Id.ToString() == currentTenantId))
            .OrderBy(t => t.Name)
            .ToListAsync();

        if (!isAdmin && tenants.Count == 1)
        {
            selectedTenant = tenants[0];
            selectedTenantId = tenants[0].Id.ToString();
        }

        UpdateSnippets();
        languageMigrationSnippet = string.Join(Environment.NewLine, new[]
        {
            "dotnet ef migrations add AddNewLanguage --project HattieAI.Infrastructure --startup-project HattieAI.API",
            "dotnet ef database update --project HattieAI.Infrastructure --startup-project HattieAI.API"
        });
    }

    private void UpdateSnippets()
    {
        var tenantId = string.IsNullOrWhiteSpace(selectedTenantId) ? "YOUR_TENANT_ID" : selectedTenantId;

        standardSnippet = string.Join(Environment.NewLine, new[]
        {
            $"<link rel=\"stylesheet\" href=\"{chatbotPublicUrl}/assets/index.css\">",
            $"<script src=\"{chatbotPublicUrl}/assets/index.js\" ",
            $"        data-tenant-id=\"{tenantId}\" ",
            $"        data-api-url=\"{chatbotPublicUrl}\" ",
            $"        defer></{ "script" }>"
        });

        nextJsSnippet = string.Join(Environment.NewLine, new[]
        {
            "import Script from \"next/script\";",
            "",
            "export default function RootLayout({ children }: { children: React.ReactNode }) {",
            "  return (",
            "    <html lang=\"en\">",
            "      <head>",
            $"        <link rel=\"stylesheet\" href=\"{chatbotPublicUrl}/assets/index.css\" />",
            "      </head>",
            "      <body>",
            "        {children}",
            "        <Script",
            $"          src=\"{chatbotPublicUrl}/assets/index.js\" ",
            "          strategy=\"afterInteractive\" ",
            $"          data-tenant-id=\"{tenantId}\" ",
            $"          data-api-url=\"{chatbotPublicUrl}\" ",
            "        />",
            "      </body>",
            "    </html>",
            "  );",
            "}"
        });

        wordPressSnippet = string.Join(Environment.NewLine, new[]
        {
            "function add_hattie_ai_chatbot() {",
            $"    wp_enqueue_style('hattie-ai', '{chatbotPublicUrl}/assets/index.css');",
            $"    wp_enqueue_script('hattie-ai', '{chatbotPublicUrl}/assets/index.js', array(), null, true);",
            "}",
            "add_action('wp_enqueue_scripts', 'add_hattie_ai_chatbot');",
            "",
            "function add_hattie_ai_attributes($tag, $handle) {",
            "    if ($handle !== 'hattie-ai') return $tag;",
            $"    return '<script src=\"{chatbotPublicUrl}/assets/index.js\" data-tenant-id=\"{tenantId}\" data-api-url=\"{chatbotPublicUrl}\" defer></{ "script" }>';",
            "}",
            "add_filter('script_loader_tag', 'add_hattie_ai_attributes', 10, 2);"
        });
    }

    private async Task CopyToClipboard(string value)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", value);
    }

    private async Task ScrollToSection(string sectionId)
    {
        await JSRuntime.InvokeVoidAsync("window.portalUi.scrollToId", sectionId);
    }

    private static string NavigationFallback()
    {
        return "http://localhost:5039";
    }
}
