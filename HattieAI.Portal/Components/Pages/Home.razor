@page "/"
@using HattieAI.Portal.Auth
@using HattieAI.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@using HattieAI.Domain.Entities
@attribute [Authorize]
@inject IDbContextFactory<HattieDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Dashboard | Hattie AI</PageTitle>

<div class="dashboard-container">
    <!-- Top Bar: Dates & Actions -->
    <div class="dashboard-controls">
        <div class="date-picker-mock">
            <i class="bi bi-calendar4"></i>
            <span>Last 30 Days</span>
            <i class="bi bi-chevron-down text-muted ms-2" style="font-size: 0.75rem;"></i>
        </div>
        <div class="control-actions">
            <button class="btn btn-white btn-sm"><i class="bi bi-arrow-clockwise"></i></button>
            <button class="btn btn-white btn-sm"><i class="bi bi-download"></i> Export</button>
            <a href="clients" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i> New Client</a>
        </div>
    </div>

    <!-- KPI Row -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-content">
                <span class="kpi-label">Total Clients</span>
                <div class="kpi-value-row">
                    <span class="kpi-value">@totalClients</span>
                    <span class="kpi-trend positive"><i class="bi bi-arrow-up"></i> 12%</span>
                </div>
            </div>
            <div class="kpi-chart">
                <canvas id="spark1"></canvas>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-content">
                <span class="kpi-label">Active Sessions</span>
                <div class="kpi-value-row">
                    <span class="kpi-value">@totalSessions</span>
                    <span class="kpi-trend positive"><i class="bi bi-arrow-up"></i> 8%</span>
                </div>
            </div>
            <div class="kpi-chart">
                <canvas id="spark2"></canvas>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-content">
                <span class="kpi-label">Processed Messages</span>
                <div class="kpi-value-row">
                    <span class="kpi-value">@totalMessages</span>
                    <span class="kpi-trend positive"><i class="bi bi-arrow-up"></i> 24%</span>
                </div>
            </div>
            <div class="kpi-chart">
                <canvas id="spark3"></canvas>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-content">
                <span class="kpi-label">Avg Response</span>
                <div class="kpi-value-row">
                    <span class="kpi-value">1.4s</span>
                    <span class="kpi-trend positive"><i class="bi bi-arrow-down"></i> 0.2s</span>
                </div>
            </div>
            <div class="kpi-chart">
                <canvas id="spark4"></canvas>
            </div>
        </div>
    </div>

    <!-- Main Analytics Grid -->
    <div class="analytics-grid">
        <!-- Traffic Chart -->
        <div class="card chart-card main-chart">
            <div class="card-header">
                <h3>Traffic Overview</h3>
                <div class="card-options">
                    <span class="badge bg-light text-dark">Sessions</span>
                    <span class="badge bg-light text-dark">Messages</span>
                </div>
            </div>
            <div class="card-body chart-body">
                <canvas id="trafficChart"></canvas>
            </div>
        </div>

        <!-- Usage Distribution -->
        <div class="card chart-card">
            <div class="card-header">
                <h3>Platform Usage</h3>
            </div>
            <div class="card-body chart-body relative">
                <canvas id="usageChart"></canvas>
                <div class="chart-center-text">
                    <span class="h4 fw-bold mb-0">100%</span>
                    <small class="text-muted">Total</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Metrics -->
    <div class="details-grid">
        <!-- Recent Clients Table -->
        <div class="card table-card">
            <div class="card-header">
                <h3>Recent Onboarding</h3>
                <a href="clients" class="link-sm">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Client</th>
                            <th>Status</th>
                            <th>Integration</th>
                            <th>Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (recentClients != null && recentClients.Any())
                        {
                            @foreach (var client in recentClients)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm me-3">@client.Name.Substring(0, 1).ToUpper()</div>
                                            <div>
                                                <div class="fw-bold">@client.Name</div>
                                                <div class="text-muted small">ID: @client.Id.ToString().Substring(0, 8)...</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-success-subtle text-success">Active</span></td>
                                    <td>
                                        <div class="progress" style="height: 4px; width: 60px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: 75%"></div>
                                        </div>
                                    </td>
                                    <td class="text-muted small">@client.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</td>
                                    <td><button class="btn btn-icon btn-sm"><i class="bi bi-three-dots-vertical"></i></button></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4">
                                    <div class="text-muted d-flex flex-column align-items-center">
                                        <i class="bi bi-inbox fs-3 mb-2"></i>
                                        <span>No recent activity found.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- System Health -->
        <div class="card health-card">
            <div class="card-header">
                <h3>System Health</h3>
            </div>
            <div class="card-body">
                <div class="health-item">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">API Latency</span>
                        <span class="fw-bold small">45ms</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: 15%"></div>
                    </div>
                </div>
                
                <div class="health-item mt-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Database Load</span>
                        <span class="fw-bold small">12%</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-primary" style="width: 12%"></div>
                    </div>
                </div>

                <div class="health-item mt-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">AI Token Usage</span>
                        <span class="fw-bold small">84%</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-warning" style="width: 84%"></div>
                    </div>
                </div>

                <div class="health-alert mt-4">
                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                    <span class="small text-muted">All systems operational</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-container {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
        width: 100%;
    }

    /* Controls */
    .dashboard-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .date-picker-mock {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: var(--backdrop-blur);
        border: 1px solid var(--border-color);
        padding: 0.5rem 1.2rem;
        border-radius: var(--border-radius-sm);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.88rem;
        font-weight: 500;
        color: var(--text-color);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .date-picker-mock:hover {
        background: rgba(255, 255, 255, 0.07);
        border-color: var(--primary-light);
    }

    .control-actions {
        display: flex;
        gap: 0.5rem;
    }

    .btn-white {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: var(--backdrop-blur);
        border: 1px solid var(--border-color);
        color: var(--text-color);
        font-size: 0.88rem;
        font-weight: 500;
        padding: 0.5rem 1rem;
        border-radius: var(--border-radius-sm);
        transition: all 0.2s ease;
    }
    
    .btn-white:hover {
        background: rgba(255, 255, 255, 0.07);
        border-color: var(--primary-light);
        color: white;
    }

    /* KPI Grid */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }

    .kpi-card {
        background: rgba(17, 24, 39, 0.55);
        backdrop-filter: var(--backdrop-blur);
        -webkit-backdrop-filter: var(--backdrop-blur);
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md), 0 0 15px rgba(99, 102, 241, 0.08);
        border-color: rgba(99, 102, 241, 0.25);
    }

    .kpi-content {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .kpi-label {
        font-size: 0.72rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    .kpi-value-row {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
    }

    .kpi-value {
        font-size: 1.8rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1;
        letter-spacing: -0.02em;
    }

    .kpi-trend {
        font-size: 0.78rem;
        font-weight: 600;
        padding: 0.1rem 0.5rem;
        border-radius: 99px;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .kpi-trend.positive { 
        background: rgba(16, 185, 129, 0.12);
        color: #34d399; 
    }

    .kpi-chart {
        width: 80px;
        height: 40px;
    }

    /* Analytics Grid */
    .analytics-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
    }

    .chart-card {
        height: 400px;
        display: flex;
        flex-direction: column;
    }

    .chart-body {
        flex: 1;
        position: relative;
        overflow: hidden;
    }

    .chart-center-text {
        position: absolute;
        top: 45%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        pointer-events: none;
    }

    /* Details Grid */
    .details-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
    }

    .avatar-sm {
        width: 38px;
        height: 38px;
        background: var(--primary-gradient);
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.95rem;
        box-shadow: 0 4px 10px rgba(99, 102, 241, 0.2);
    }

    .btn-icon {
        color: var(--text-muted);
        border: none;
        background: transparent;
        transition: color 0.2s;
    }

    .btn-icon:hover {
        color: white;
    }

    .link-sm {
        font-size: 0.85rem;
        text-decoration: none;
        color: var(--primary-light);
        font-weight: 600;
        transition: color 0.2s;
    }

    .link-sm:hover {
        color: white;
        text-decoration: underline;
    }

    .health-alert {
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.15);
        padding: 0.85rem;
        border-radius: 10px;
        display: flex;
        align-items: center;
    }

    .health-item {
        background: rgba(255, 255, 255, 0.01);
        border: 1px solid var(--border-color);
        padding: 1rem;
        border-radius: 10px;
    }

    .health-card .progress {
        background-color: rgba(255, 255, 255, 0.05);
    }

    @@media (max-width: 1200px) {
        .kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .analytics-grid { grid-template-columns: 1fr; }
        .details-grid { grid-template-columns: 1fr; }
    }
    
    @@media (max-width: 768px) {
        .kpi-grid { grid-template-columns: 1fr; }
    }
</style>

@code {
    private int totalClients;
    private int totalSessions;
    private int totalMessages;
    private int clientsWithKnowledge;
    private double avgResponse = 1.2; // Placeholder until we have timestamps for response
    private string userName = "Admin";
    private List<Tenant> recentClients = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
            userName = user.Identity.Name ?? "Admin";

        using var context = DbFactory.CreateDbContext();
        
        var queryableTenants = context.Tenants.IgnoreQueryFilters();
        var queryableSessions = context.ChatSessions.IgnoreQueryFilters();
        var queryableMessages = context.ChatMessages.IgnoreQueryFilters();

        totalClients = await queryableTenants.CountAsync();
        totalSessions = await queryableSessions.CountAsync();
        totalMessages = await queryableMessages.CountAsync();
        
        clientsWithKnowledge = await queryableTenants
            .Where(t => !string.IsNullOrEmpty(t.KnowledgeBaseText))
            .CountAsync();

        recentClients = await queryableTenants
            .OrderByDescending(t => t.CreatedAt)
            .Take(5)
            .ToListAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                using var context = DbFactory.CreateDbContext();
                
                // --- 1. Fetch Real Data for Last 7 Days ---
                var endDate = DateTime.UtcNow.Date;
                var startDate = endDate.AddDays(-6);
                
                // Helper to get daily counts
                // Note: In EF Core with Postgres, strictly we might need 'Date' truncation, 
                // but for simplicity fetching all recent records and grouping in memory is lesser risk for small datasets
                // For production with massive data, move grouping to DB.
                
                var sessionsRecent = await context.ChatSessions.IgnoreQueryFilters()
                    .Where(s => s.CreatedAt >= startDate)
                    .Select(s => s.CreatedAt)
                    .ToListAsync();

                var messagesRecent = await context.ChatMessages.IgnoreQueryFilters()
                    .Where(m => m.CreatedAt >= startDate)
                    .Select(m => new { m.CreatedAt, m.Role })
                    .ToListAsync();
                    
                var tenantsRecent = await context.Tenants.IgnoreQueryFilters()
                    .Where(t => t.CreatedAt >= startDate)
                    .Select(t => t.CreatedAt)
                    .ToListAsync();

                // --- 2. Process Data buckets ---
                var labels = new string[7];
                var sessionData = new int[7];
                var messageData = new int[7];
                var clientSpark = new int[7];
                var messagesSpark = new int[7]; 
                
                for (int i = 0; i < 7; i++)
                {
                    var date = startDate.AddDays(i);
                    labels[i] = date.ToString("MMM dd");
                    
                    var dateNext = date.AddDays(1);
                    
                    sessionData[i] = sessionsRecent.Count(s => s >= date && s < dateNext);
                    messageData[i] = messagesRecent.Count(m => m.CreatedAt >= date && m.CreatedAt < dateNext);
                    clientSpark[i] = tenantsRecent.Count(t => t >= date && t < dateNext);
                }

                // Interactive Breakdown (User vs Model)
                var userMsgCount = await context.ChatMessages.IgnoreQueryFilters().CountAsync(m => m.Role == "user");
                var aiMsgCount = await context.ChatMessages.IgnoreQueryFilters().CountAsync(m => m.Role == "model" || m.Role == "assistant"); // covering potential role names
                var usageData = new[] { userMsgCount, aiMsgCount, 0 }; // Mobile is 0 for now
                
                // --- 3. Render Charts ---
                
                // Main Traffic Chart
                await JSRuntime.InvokeVoidAsync("window.dashboardChart.renderTrafficChart", "trafficChart", labels, sessionData, messageData);
                
                // Interaction Chart (Replacing 'Platform Usage' with 'Message Role Breakdown' effectively)
                // We'll keep the function name renderUsageChart but pass User/AI breakdown
                await JSRuntime.InvokeVoidAsync("window.dashboardChart.renderUsageChart", "usageChart", usageData);

                // Sparklines
                // For sparklines we might want a slightly longer history if available, but 7 days is fine for "recent trend"
                await JSRuntime.InvokeVoidAsync("window.dashboardChart.renderSparkline", "spark1", clientSpark, "#3730a3"); // Client Growth
                await JSRuntime.InvokeVoidAsync("window.dashboardChart.renderSparkline", "spark2", sessionData, "#6366f1"); // Sessions
                await JSRuntime.InvokeVoidAsync("window.dashboardChart.renderSparkline", "spark3", messageData, "#10b981"); // Messages
                await JSRuntime.InvokeVoidAsync("window.dashboardChart.renderSparkline", "spark4", new[] { 12, 11, 10, 12, 13, 11, 12 }, "#f59e0b"); // Dummy latency for now
            }
            catch (Exception ex)
            {
               Console.WriteLine($"Error rendering charts: {ex.Message}");
            }
        }
    }
}
