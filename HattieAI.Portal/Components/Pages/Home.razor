@page "/"
@using HattieAI.Portal.Auth
@using HattieAI.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@using HattieAI.Domain.Entities
@attribute [Authorize]
@inject IDbContextFactory<HattieDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Dashboard | Hattie AI</PageTitle>

<div class="dashboard-container">
    <!-- Top Bar: Dates & Actions -->
    <div class="dashboard-controls">
        <div class="date-picker-mock">
            <i class="bi bi-calendar4"></i>
            <span>Last 30 Days</span>
            <i class="bi bi-chevron-down text-muted ms-2" style="font-size: 0.75rem;"></i>
        </div>
        <div class="control-actions">
            <button class="btn btn-white btn-sm"><i class="bi bi-arrow-clockwise"></i></button>
            <button class="btn btn-white btn-sm"><i class="bi bi-download"></i> Export</button>
            @if (canManageClients)
            {
                <a href="clients" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i> New Client</a>
            }
        </div>
    </div>

    <!-- KPI Row -->
    <div class="kpi-grid">
        @if (canManageClients)
        {
            <div class="kpi-card">
                <div class="kpi-content">
                    <span class="kpi-label">Total Clients</span>
                    <div class="kpi-value-row">
                        <span class="kpi-value">@totalClients</span>
                        <span class="kpi-trend neutral">@clientsLast30Days new</span>
                    </div>
                </div>
                <div class="kpi-chart">
                    <canvas id="spark1"></canvas>
                </div>
            </div>
        }
        else
        {
            <div class="kpi-card">
                <div class="kpi-content">
                    <span class="kpi-label">Workspace Status</span>
                    <div class="kpi-value-row">
                        <span class="kpi-value" style="font-size: 1.4rem; max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@clientTenantName">@clientTenantName</span>
                        <span class="kpi-trend positive"><i class="bi bi-circle-fill" style="font-size: 0.5rem; margin-right: 2px;"></i> Active</span>
                    </div>
                </div>
                <div class="kpi-chart" style="display: flex; align-items: center; justify-content: center; height: 100%;">
                    <i class="bi bi-patch-check-fill text-success fs-3"></i>
                </div>
            </div>
        }

        <div class="kpi-card">
            <div class="kpi-content">
                <span class="kpi-label">Active Sessions</span>
                <div class="kpi-value-row">
                    <span class="kpi-value">@totalSessions</span>
                    <span class="kpi-trend neutral">@sessionsLast30Days recent</span>
                </div>
            </div>
            <div class="kpi-chart">
                <canvas id="spark2"></canvas>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-content">
                <span class="kpi-label">Processed Messages</span>
                <div class="kpi-value-row">
                    <span class="kpi-value">@totalMessages</span>
                    <span class="kpi-trend neutral">@messagesLast30Days recent</span>
                </div>
            </div>
            <div class="kpi-chart">
                <canvas id="spark3"></canvas>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-content">
                <span class="kpi-label">Token Usage</span>
                <div class="kpi-value-row">
                    <span class="kpi-value">@totalMonthlyTokenUsage.ToString("N0")</span>
                    <span class="kpi-trend neutral">@tokenUsagePercent% used</span>
                </div>
            </div>
            <div class="kpi-chart">
                <canvas id="spark4"></canvas>
            </div>
        </div>
    </div>

    <!-- Main Analytics Grid -->
    <div class="analytics-grid">
        <!-- Traffic Chart -->
        <div class="card chart-card main-chart">
            <div class="card-header">
                <h3>Traffic Overview</h3>
                <div class="card-options">
                    <span class="badge bg-light text-dark">Sessions</span>
                    <span class="badge bg-light text-dark">Messages</span>
                </div>
            </div>
            <div class="card-body chart-body">
                <canvas id="trafficChart"></canvas>
            </div>
        </div>

        <!-- Usage Distribution -->
        <div class="card chart-card">
            <div class="card-header">
                <h3>Platform Usage</h3>
            </div>
            <div class="card-body chart-body relative">
                <canvas id="usageChart"></canvas>
                <div class="chart-center-text">
                    <span class="h4 fw-bold mb-0">@totalMessages</span>
                    <small class="text-muted">Messages</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Metrics -->
    <div class="details-grid">
        @if (canManageClients)
        {
            <!-- Recent Clients Table -->
            <div class="card table-card">
                <div class="card-header">
                    <h3>Recent Onboarding</h3>
                    <a href="clients" class="link-sm">View All</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Client</th>
                                <th>Status</th>
                                <th>Token Usage</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentClients != null && recentClients.Any())
                            {
                                @foreach (var client in recentClients)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm me-3">@client.Name.Substring(0, 1).ToUpper()</div>
                                                <div>
                                                    <div class="fw-bold">@client.Name</div>
                                                    <div class="text-muted small">ID: @client.Id.ToString().Substring(0, 8)...</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="badge bg-success-subtle text-success">Active</span></td>
                                        <td>
                                            <div class="usage-mini">
                                                <span>@client.MonthlyTokenUsage.ToString("N0") / @client.MonthlyTokenLimit.ToString("N0")</span>
                                                <div class="progress" style="height: 4px; width: 110px;">
                                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @GetUsagePercent(client)%"></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-muted small">@client.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</td>
                                        <td><button class="btn btn-icon btn-sm"><i class="bi bi-three-dots-vertical"></i></button></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4">
                                        <div class="text-muted d-flex flex-column align-items-center">
                                            <i class="bi bi-inbox fs-3 mb-2"></i>
                                            <span>No recent activity found.</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Configuration Health -->
            <div class="card health-card">
                <div class="card-header">
                    <h3>Configuration Health</h3>
                </div>
                <div class="card-body">
                    <div class="health-item">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Clients with Knowledge</span>
                            <span class="fw-bold small">@knowledgeCoverage%</span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-success" style="width: @knowledgeCoverage%"></div>
                        </div>
                    </div>
                    
                    <div class="health-item mt-4">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Clients with Websites</span>
                            <span class="fw-bold small">@originCoverage%</span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-primary" style="width: @originCoverage%"></div>
                        </div>
                    </div>

                    <div class="health-item mt-4">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Language Configured</span>
                            <span class="fw-bold small">@languageCoverage%</span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar bg-warning" style="width: @languageCoverage%"></div>
                        </div>
                    </div>

                    <div class="health-alert mt-4">
                        <i class="bi bi-info-circle-fill text-info me-2"></i>
                        <span class="small text-muted">@configurationSummary</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Recent Chat Sessions Table for Client -->
            <div class="card table-card">
                <div class="card-header">
                    <h3>Recent Conversations</h3>
                    <a href="crm-leads" class="link-sm">View Inbox</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Contact / Session</th>
                                <th>Channel</th>
                                <th>Last Activity</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentSessions != null && recentSessions.Any())
                            {
                                @foreach (var session in recentSessions)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm me-3" style="background: var(--primary-gradient); display: flex; align-items: center; justify-content: center; font-weight: 700; color: white;">
                                                    @GetAvatarText(session.ContactName ?? session.Title)
                                                </div>
                                                <div>
                                                    <div class="fw-bold">@(session.ContactName ?? session.Title)</div>
                                                    <div class="text-muted small">ID: @session.Id.ToString().Substring(0, 8)...</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            @if (session.Channel == "WhatsApp")
                                            {
                                                <span class="badge bg-success-subtle text-success"><i class="bi bi-whatsapp"></i> WhatsApp</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary-subtle text-primary"><i class="bi bi-chat-dots"></i> Web</span>
                                            }
                                        </td>
                                        <td class="text-muted small">@session.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</td>
                                        <td><span class="badge bg-info-subtle text-info">Connected</span></td>
                                        <td>
                                            <a href="crm-leads" class="btn btn-icon btn-sm" title="View Chat">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4">
                                        <div class="text-muted d-flex flex-column align-items-center">
                                            <i class="bi bi-chat-left-dots fs-3 mb-2"></i>
                                            <span>No recent conversations found.</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Client Workspace Configurations -->
            <div class="card health-card">
                <div class="card-header">
                    <h3>Workspace Configuration</h3>
                </div>
                <div class="card-body">
                    @if (clientTenant != null)
                    {
                        <div class="health-item">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small"><i class="bi bi-chat-dots-fill text-primary me-2"></i> Website Chatbot</span>
                                <span class="badge @(clientTenant.IsWebsiteChatbotEnabled ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                    @(clientTenant.IsWebsiteChatbotEnabled ? "Enabled" : "Disabled")
                                </span>
                            </div>
                            @if (clientTenant.IsWebsiteChatbotEnabled)
                            {
                                <div class="mt-2 small text-muted">
                                    <strong>Allowed Websites:</strong>
                                    <div class="text-truncate" style="max-width: 250px;" title="@(clientTenant.AllowedOrigins != null ? string.Join(", ", clientTenant.AllowedOrigins) : "")">
                                        @(clientTenant.AllowedOrigins != null && clientTenant.AllowedOrigins.Any() 
                                            ? string.Join(", ", clientTenant.AllowedOrigins) 
                                            : "No website origins configured yet.")
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <div class="health-item mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small"><i class="bi bi-whatsapp text-success me-2"></i> WhatsApp Integration</span>
                                <span class="badge @(clientTenant.IsWhatsAppEnabled ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                    @(clientTenant.IsWhatsAppEnabled ? "Enabled" : "Disabled")
                                </span>
                            </div>
                        </div>

                        <div class="health-item mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small"><i class="bi bi-translate text-warning me-2"></i> Languages</span>
                                <span class="fw-bold small text-muted">@clientLanguagesCount active</span>
                            </div>
                        </div>

                        <div class="health-alert mt-4">
                            <i class="bi bi-info-circle-fill text-info me-2"></i>
                            <span class="small text-muted">Go to <a href="client-configuration" class="text-primary fw-semibold">Configuration</a> or <a href="knowledge-base" class="text-primary fw-semibold">Knowledge Base</a> to adjust settings.</span>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small">Loading configuration details...</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    .dashboard-container {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
        width: 100%;
    }

    /* Controls */
    .dashboard-controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .date-picker-mock {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: var(--backdrop-blur);
        border: 1px solid var(--border-color);
        padding: 0.5rem 1.2rem;
        border-radius: var(--border-radius-sm);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.88rem;
        font-weight: 500;
        color: var(--text-color);
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .date-picker-mock:hover {
        background: rgba(255, 255, 255, 0.07);
        border-color: var(--primary-light);
    }

    .control-actions {
        display: flex;
        gap: 0.5rem;
    }

    .btn-white {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: var(--backdrop-blur);
        border: 1px solid var(--border-color);
        color: var(--text-color);
        font-size: 0.88rem;
        font-weight: 500;
        padding: 0.5rem 1rem;
        border-radius: var(--border-radius-sm);
        transition: all 0.2s ease;
    }
    
    .btn-white:hover {
        background: rgba(255, 255, 255, 0.07);
        border-color: var(--primary-light);
        color: white;
    }

    /* KPI Grid */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }

    .kpi-card {
        background: rgba(17, 24, 39, 0.55);
        backdrop-filter: var(--backdrop-blur);
        -webkit-backdrop-filter: var(--backdrop-blur);
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        box-shadow: var(--shadow-sm);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md), 0 0 15px rgba(99, 102, 241, 0.08);
        border-color: rgba(99, 102, 241, 0.25);
    }

    .kpi-content {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .kpi-label {
        font-size: 0.72rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    .kpi-value-row {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
    }

    .kpi-value {
        font-size: 1.8rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1;
        letter-spacing: -0.02em;
    }

    .kpi-trend {
        font-size: 0.78rem;
        font-weight: 600;
        padding: 0.1rem 0.5rem;
        border-radius: 99px;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .kpi-trend.positive { 
        background: rgba(16, 185, 129, 0.12);
        color: #34d399; 
    }

    .kpi-trend.neutral {
        background: rgba(6, 182, 212, 0.12);
        color: #67e8f9;
    }

    .kpi-chart {
        width: 80px;
        height: 40px;
    }

    /* Analytics Grid */
    .analytics-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
    }

    .chart-card {
        height: 400px;
        display: flex;
        flex-direction: column;
    }

    .chart-body {
        flex: 1;
        position: relative;
        overflow: hidden;
    }

    .chart-center-text {
        position: absolute;
        top: 45%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        pointer-events: none;
    }

    /* Details Grid */
    .details-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
    }

    .avatar-sm {
        width: 38px;
        height: 38px;
        background: var(--primary-gradient);
        color: white;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.95rem;
        box-shadow: 0 4px 10px rgba(99, 102, 241, 0.2);
    }

    .btn-icon {
        color: var(--text-muted);
        border: none;
        background: transparent;
        transition: color 0.2s;
    }

    .btn-icon:hover {
        color: white;
    }

    .link-sm {
        font-size: 0.85rem;
        text-decoration: none;
        color: var(--primary-light);
        font-weight: 600;
        transition: color 0.2s;
    }

    .link-sm:hover {
        color: white;
        text-decoration: underline;
    }

    .health-alert {
        background: rgba(16, 185, 129, 0.08);
        border: 1px solid rgba(16, 185, 129, 0.15);
        padding: 0.85rem;
        border-radius: 10px;
        display: flex;
        align-items: center;
    }

    .health-item {
        background: rgba(255, 255, 255, 0.01);
        border: 1px solid var(--border-color);
        padding: 1rem;
        border-radius: 10px;
    }

    .health-card .progress {
        background-color: rgba(255, 255, 255, 0.05);
    }

    .usage-mini {
        display: grid;
        gap: 0.3rem;
        color: var(--text-muted);
        font-size: 0.78rem;
        font-weight: 700;
        white-space: nowrap;
    }

    @@media (max-width: 1200px) {
        .kpi-grid { grid-template-columns: repeat(2, 1fr); }
        .analytics-grid { grid-template-columns: 1fr; }
        .details-grid { grid-template-columns: 1fr; }
    }
    
    @@media (max-width: 768px) {
        .kpi-grid { grid-template-columns: 1fr; }
    }
</style>

@code {
    private int totalClients;
    private int totalSessions;
    private int totalMessages;
    private int clientsWithKnowledge;
    private int clientsLast30Days;
    private int sessionsLast30Days;
    private int messagesLast30Days;
    private int totalMonthlyTokenUsage;
    private int totalMonthlyTokenLimit;
    private int tokenUsagePercent;
    private int clientsWithOrigins;
    private int clientsWithLanguages;
    private int knowledgeCoverage;
    private int originCoverage;
    private int languageCoverage;
    private string configurationSummary = "Configuration data is loading.";
    private string userName = "Admin";
    private bool canManageClients;
    private List<Tenant> recentClients = new();
    private List<ChatSession> recentSessions = new();
    private Tenant? clientTenant;
    private int clientLanguagesCount;
    private string clientTenantName = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
            userName = user.Identity.Name ?? "Admin";
        var isAdmin = user.IsInRole("Admin");
        canManageClients = isAdmin;
        var tenantId = user.FindFirst("TenantId")?.Value ?? string.Empty;

        using var context = DbFactory.CreateDbContext();
        
        var queryableTenants = GetAccessibleTenants(context, isAdmin, tenantId);
        var accessibleTenantIds = await queryableTenants.Select(t => t.TenantId).ToListAsync();
        var queryableSessions = isAdmin
            ? context.ChatSessions.IgnoreQueryFilters()
            : context.ChatSessions.IgnoreQueryFilters().Where(s => accessibleTenantIds.Contains(s.TenantId));
        var queryableMessages = isAdmin
            ? context.ChatMessages.IgnoreQueryFilters()
            : context.ChatMessages.IgnoreQueryFilters().Where(m => accessibleTenantIds.Contains(m.TenantId));

        totalClients = await queryableTenants.CountAsync();
        totalSessions = await queryableSessions.CountAsync();
        totalMessages = await queryableMessages.CountAsync();
        totalMonthlyTokenUsage = await queryableTenants.SumAsync(t => t.MonthlyTokenUsage);
        totalMonthlyTokenLimit = await queryableTenants.SumAsync(t => t.MonthlyTokenLimit);
        tokenUsagePercent = Percent(totalMonthlyTokenUsage, totalMonthlyTokenLimit);

        var last30Days = DateTime.UtcNow.AddDays(-30);
        clientsLast30Days = await queryableTenants.CountAsync(t => t.CreatedAt >= last30Days);
        sessionsLast30Days = await queryableSessions.CountAsync(s => s.CreatedAt >= last30Days);
        messagesLast30Days = await queryableMessages.CountAsync(m => m.CreatedAt >= last30Days);
        
        clientsWithKnowledge = await queryableTenants
            .Where(t => !string.IsNullOrEmpty(t.KnowledgeBaseText))
            .CountAsync();
        clientsWithOrigins = await queryableTenants.CountAsync(t => t.AllowedOrigins.Count > 0);
        clientsWithLanguages = await queryableTenants
            .Include(t => t.SupportedLanguages)
            .CountAsync(t => t.SupportedLanguages.Any());

        knowledgeCoverage = Percent(clientsWithKnowledge, totalClients);
        originCoverage = Percent(clientsWithOrigins, totalClients);
        languageCoverage = Percent(clientsWithLanguages, totalClients);
        configurationSummary = totalClients == 0
            ? "No clients have been onboarded yet."
            : $"{clientsWithKnowledge} knowledge bases, {clientsWithOrigins} website allowlists, {clientsWithLanguages} language profiles configured.";

        recentClients = await queryableTenants
            .OrderByDescending(t => t.CreatedAt)
            .Take(5)
            .ToListAsync();

        if (!isAdmin && !string.IsNullOrEmpty(tenantId))
        {
            clientTenant = await queryableTenants
                .Include(t => t.SupportedLanguages)
                .FirstOrDefaultAsync();
            if (clientTenant != null)
            {
                clientTenantName = clientTenant.Name;
                clientLanguagesCount = clientTenant.SupportedLanguages?.Count ?? 0;
            }

            recentSessions = await queryableSessions
                .OrderByDescending(s => s.CreatedAt)
                .Take(5)
                .ToListAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                using var context = DbFactory.CreateDbContext();
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                var isAdmin = user.IsInRole("Admin");
                var tenantId = user.FindFirst("TenantId")?.Value ?? string.Empty;
                var queryableTenants = GetAccessibleTenants(context, isAdmin, tenantId);
                var accessibleTenantIds = await queryableTenants.Select(t => t.TenantId).ToListAsync();
                var queryableSessions = isAdmin
                    ? context.ChatSessions.IgnoreQueryFilters()
                    : context.ChatSessions.IgnoreQueryFilters().Where(s => accessibleTenantIds.Contains(s.TenantId));
                var queryableMessages = isAdmin
                    ? context.ChatMessages.IgnoreQueryFilters()
                    : context.ChatMessages.IgnoreQueryFilters().Where(m => accessibleTenantIds.Contains(m.TenantId));
                
                // --- 1. Fetch Real Data for Last 7 Days ---
                var endDate = DateTime.UtcNow.Date;
                var startDate = endDate.AddDays(-6);
                
                var sessionsRecent = await queryableSessions
                    .Where(s => s.CreatedAt >= startDate)
                    .Select(s => s.CreatedAt)
                    .ToListAsync();

                var messagesRecent = await queryableMessages
                    .Where(m => m.CreatedAt >= startDate)
                    .Select(m => new { m.CreatedAt, m.Role })
                    .ToListAsync();
                    
                var tenantsRecent = await queryableTenants
                    .Where(t => t.CreatedAt >= startDate)
                    .Select(t => t.CreatedAt)
                    .ToListAsync();

                // --- 2. Process Data buckets ---
                var labels = new string[7];
                var sessionData = new int[7];
                var messageData = new int[7];
                var clientSpark = new int[7];
                
                for (int i = 0; i < 7; i++)
                {
                    var date = startDate.AddDays(i);
                    labels[i] = date.ToString("MMM dd");
                    
                    var dateNext = date.AddDays(1);
                    
                    sessionData[i] = sessionsRecent.Count(s => s >= date && s < dateNext);
                    messageData[i] = messagesRecent.Count(m => m.CreatedAt >= date && m.CreatedAt < dateNext);
                    clientSpark[i] = tenantsRecent.Count(t => t >= date && t < dateNext);
                }

                // Interactive Breakdown (User vs Model)
                var userMsgCount = await queryableMessages.CountAsync(m => m.Role == "user");
                var aiMsgCount = await queryableMessages.CountAsync(m => m.Role == "model" || m.Role == "assistant");
                var usageData = new[] { userMsgCount, aiMsgCount, 0 };
                
                // --- 3. Render Charts ---
                await JSRuntime.InvokeVoidAsync("window.dashboardChart.renderTrafficChart", "trafficChart", labels, sessionData, messageData);
                await JSRuntime.InvokeVoidAsync("window.dashboardChart.renderUsageChart", "usageChart", usageData);

                // Sparklines
                await JSRuntime.InvokeVoidAsync("window.dashboardChart.renderSparkline", "spark1", clientSpark, "#3730a3");
                await JSRuntime.InvokeVoidAsync("window.dashboardChart.renderSparkline", "spark2", sessionData, "#6366f1");
                await JSRuntime.InvokeVoidAsync("window.dashboardChart.renderSparkline", "spark3", messageData, "#10b981");
                await JSRuntime.InvokeVoidAsync("window.dashboardChart.renderSparkline", "spark4", clientSpark, "#f59e0b");
            }
            catch (Exception ex)
            {
               Console.WriteLine($"Error rendering charts: {ex.Message}");
            }
        }
    }

    private static int Percent(int value, int total)
    {
        if (total <= 0) return 0;
        return (int)Math.Round(value * 100d / total);
    }

    private static int GetUsagePercent(Tenant tenant)
    {
        if (tenant.MonthlyTokenLimit <= 0)
            return 100;

        return Math.Clamp((int)Math.Round(tenant.MonthlyTokenUsage * 100d / tenant.MonthlyTokenLimit), 0, 100);
    }

    private static string GetAvatarText(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "C";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();
        }
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    private static IQueryable<Tenant> GetAccessibleTenants(HattieDbContext context, bool isAdmin, string tenantId)
    {
        var tenantsQuery = context.Tenants.IgnoreQueryFilters();
        return isAdmin ? tenantsQuery : tenantsQuery.Where(t => t.TenantId == tenantId || t.Id.ToString() == tenantId);
    }
}
