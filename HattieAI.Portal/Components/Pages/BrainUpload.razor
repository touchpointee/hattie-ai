@page "/knowledge-base"
@using HattieAI.Domain.Entities
@using HattieAI.Infrastructure.Documents
@using HattieAI.Infrastructure.Persistence
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject IDbContextFactory<HattieDbContext> DbFactory
@inject DocumentBroker DocumentBroker
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Knowledge Base | Hattie AI</PageTitle>

<div class="portal-page">
    <div class="page-heading">
        <div>
            <h1>Knowledge Base</h1>
            <p>Upload, paste, edit, and rebuild the knowledge used by each client chatbot and WhatsApp assistant.</p>
        </div>
        <div class="heading-actions">
            <span class="metric-pill">@tenants.Count clients</span>
            <span class="metric-pill">@clientsWithKnowledge ready</span>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="state-panel">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Loading knowledge bases...</span>
        </div>
    }
    else if (!tenants.Any())
    {
        <div class="state-panel">
            <i class="bi bi-book"></i>
            <strong>No clients yet</strong>
            <span>Create a client before adding chatbot knowledge.</span>
            @if (isAdmin)
            {
                <a href="clients" class="btn btn-primary mt-2">Create Client</a>
            }
        </div>
    }
    else
    {
        <div class="knowledge-layout">
            <aside class="knowledge-sidebar">
                <div class="panel-title">
                    <span>Client</span>
                    <small>Select the knowledge owner</small>
                </div>

                <select class="form-select" @bind="selectedTenantId" @bind:after="OnTenantSelected">
                    <option value="">Choose a client</option>
                    @foreach (var tenant in tenants)
                    {
                        <option value="@tenant.Id">@tenant.Name</option>
                    }
                </select>

                @if (selectedTenant != null)
                {
                    <div class="client-card">
                        <div class="client-avatar">@GetInitial(selectedTenant.Name)</div>
                        <div>
                            <strong>@selectedTenant.Name</strong>
                            <span>@selectedTenant.ContactEmail</span>
                        </div>
                    </div>

                    <div class="stat-list">
                        <div>
                            <span>Characters</span>
                            <strong>@currentKnowledge.Length</strong>
                        </div>
                        <div>
                            <span>Chunks</span>
                            <strong>@chunkCount</strong>
                        </div>
                        <div>
                            <span>Last Update</span>
                            <strong>@lastUpdatedLabel</strong>
                        </div>
                    </div>
                }
            </aside>

            <section class="knowledge-workspace">
                @if (selectedTenant == null)
                {
                    <div class="state-panel embedded">
                        <i class="bi bi-arrow-left-circle"></i>
                        <strong>Select a client</strong>
                        <span>The upload and editor tools appear after a client is selected.</span>
                    </div>
                }
                else
                {
                    <div class="workspace-grid">
                        <div class="source-panel">
                            <div class="section-title-row">
                                <div>
                                    <h2>Add Knowledge</h2>
                                    <p>Use PDFs or pasted text. Content is chunked again after every save.</p>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(successMessage))
                            {
                                <div class="alert alert-success">
                                    <i class="bi bi-check-circle me-2"></i>@successMessage
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(errorMessage))
                            {
                                <div class="alert alert-danger">
                                    <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
                                </div>
                            }

                            <label class="form-label">Source Label</label>
                            <input class="form-control mb-3" @bind="sourceLabel" placeholder="Product FAQ, Pricing Sheet, Terms PDF" />

                            <label class="form-label">PDF Upload</label>
                            <div class="upload-zone">
                                <InputFile OnChange="HandleFileSelected" class="file-input" accept=".pdf" />
                                <i class="bi bi-file-earmark-arrow-up"></i>
                                <strong>@(string.IsNullOrWhiteSpace(selectedFileName) ? "Drop or choose a PDF" : selectedFileName)</strong>
                                <span>Maximum file size: 10 MB</span>
                            </div>

                            <div class="divider"><span>or paste text</span></div>

                            <label class="form-label">Knowledge Text</label>
                            <textarea class="form-control raw-input" @bind="rawTextToAdd" placeholder="Paste verified client information here."></textarea>

                            <div class="mode-row">
                                <label class="mode-option @(writeMode == KnowledgeWriteMode.Append ? "active" : "")">
                                    <input type="radio" name="write-mode" checked="@(writeMode == KnowledgeWriteMode.Append)" @onchange="() => writeMode = KnowledgeWriteMode.Append" />
                                    <span>Append</span>
                                </label>
                                <label class="mode-option @(writeMode == KnowledgeWriteMode.Replace ? "active" : "")">
                                    <input type="radio" name="write-mode" checked="@(writeMode == KnowledgeWriteMode.Replace)" @onchange="() => writeMode = KnowledgeWriteMode.Replace" />
                                    <span>Replace</span>
                                </label>
                            </div>

                            <button class="btn btn-primary w-100" @onclick="SaveRawText" disabled="@(string.IsNullOrWhiteSpace(rawTextToAdd) || isProcessing)">
                                @if (isProcessing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                }
                                <span>@(isProcessing ? "Processing..." : writeMode == KnowledgeWriteMode.Append ? "Append Text" : "Replace Knowledge")</span>
                            </button>
                        </div>

                        <div class="editor-panel">
                            <div class="editor-toolbar">
                                <div>
                                    <h2>Current Knowledge</h2>
                                    <p>@currentKnowledge.Length characters available to the chatbot.</p>
                                </div>
                                <div class="toolbar-actions">
                                    @if (isEditing)
                                    {
                                        <button class="btn btn-sm btn-primary" @onclick="SaveKnowledgeBase" disabled="@isProcessing">
                                            <i class="bi bi-check-lg me-1"></i>Save
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit" disabled="@isProcessing">
                                            Cancel
                                        </button>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(currentKnowledge))
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="EnableEdit">
                                            <i class="bi bi-pencil me-1"></i>Edit
                                        </button>
                                    }
                                </div>
                            </div>

                            @if (string.IsNullOrWhiteSpace(currentKnowledge) && !isEditing)
                            {
                                <div class="empty-editor">
                                    <i class="bi bi-journal-plus"></i>
                                    <strong>No knowledge added</strong>
                                    <span>Add a PDF or paste text to activate retrieval for this client.</span>
                                </div>
                            }
                            else if (isEditing)
                            {
                                <textarea class="knowledge-editor" @bind="currentKnowledge" @bind:event="oninput"></textarea>
                            }
                            else
                            {
                                <div class="knowledge-reader">
                                    <pre>@currentKnowledge</pre>
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>
        </div>
    }
</div>

<style>
    .knowledge-layout {
        display: grid;
        grid-template-columns: minmax(250px, 320px) minmax(0, 1fr);
        gap: 1.25rem;
        align-items: start;
    }

    .knowledge-sidebar,
    .source-panel,
    .editor-panel {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-sm);
    }

    .knowledge-workspace {
        min-width: 0;
    }

    .knowledge-sidebar {
        position: sticky;
        top: 0;
        padding: 1rem;
    }

    .panel-title,
    .section-title-row,
    .editor-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
    }

    .panel-title {
        margin-bottom: 0.8rem;
        flex-direction: column;
        gap: 0.15rem;
    }

    .panel-title span,
    .section-title-row h2,
    .editor-toolbar h2 {
        color: var(--text-color);
        font-weight: 800;
    }

    .section-title-row h2,
    .editor-toolbar h2 {
        margin: 0;
        font-size: 1.1rem;
    }

    .panel-title small,
    .section-title-row p,
    .editor-toolbar p {
        color: var(--text-muted);
        margin: 0.2rem 0 0;
    }

    .client-card {
        display: grid;
        grid-template-columns: 42px 1fr;
        gap: 0.75rem;
        align-items: center;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: #f8fafc;
        padding: 0.8rem;
        margin-top: 1rem;
    }

    .client-avatar {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        background: #dcfce7;
        color: #166534;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .client-card strong,
    .client-card span {
        display: block;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .client-card span {
        color: var(--text-muted);
        font-size: 0.84rem;
    }

    .stat-list {
        display: grid;
        gap: 0.55rem;
        margin-top: 1rem;
    }

    .stat-list div {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 0.55rem;
    }

    .stat-list div:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .stat-list span {
        color: var(--text-muted);
        font-weight: 700;
    }

    .workspace-grid {
        display: grid;
        grid-template-columns: minmax(280px, 380px) minmax(0, 1fr);
        gap: 1.1rem;
        align-items: stretch;
    }

    .source-panel,
    .editor-panel {
        padding: 1.1rem;
        min-width: 0;
    }

    .upload-zone {
        position: relative;
        min-height: 142px;
        border: 1px dashed #94a3b8;
        background: #f8fafc;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.3rem;
        text-align: center;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .upload-zone:hover {
        border-color: var(--primary-color);
        background: #eff6ff;
    }

    .upload-zone i {
        color: var(--primary-color);
        font-size: 2rem;
    }

    .upload-zone span {
        color: var(--text-muted);
        font-size: 0.84rem;
    }

    .file-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--text-muted);
        font-size: 0.82rem;
        margin: 1rem 0;
    }

    .divider::before,
    .divider::after {
        content: "";
        height: 1px;
        background: var(--border-color);
        flex: 1;
    }

    .raw-input {
        min-height: 170px;
        resize: vertical;
    }

    .mode-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.55rem;
        margin: 0.85rem 0;
    }

    .mode-option {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.6rem;
        cursor: pointer;
        font-weight: 800;
        color: var(--text-muted);
    }

    .mode-option.active {
        border-color: var(--primary-color);
        background: #eff6ff;
        color: var(--primary-dark);
    }

    .mode-option input {
        accent-color: var(--primary-color);
    }

    .editor-panel {
        display: flex;
        flex-direction: column;
        min-height: 660px;
    }

    .editor-toolbar {
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 0.9rem;
        margin-bottom: 0.9rem;
    }

    .toolbar-actions {
        display: flex;
        gap: 0.45rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .empty-editor {
        flex: 1;
        min-height: 460px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: var(--text-muted);
        text-align: center;
        border: 1px dashed var(--border-color);
        border-radius: 8px;
        background: #f8fafc;
    }

    .empty-editor i {
        font-size: 2rem;
        color: var(--primary-color);
    }

    .empty-editor strong {
        color: var(--text-color);
    }

    .knowledge-reader,
    .knowledge-editor {
        flex: 1;
        min-height: 520px;
        width: 100%;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: #f8fafc;
        color: var(--text-color);
        font-family: 'JetBrains Mono', Consolas, monospace;
        font-size: 0.86rem;
        line-height: 1.65;
        padding: 1rem;
        overflow: auto;
    }

    .knowledge-reader pre {
        margin: 0;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .knowledge-editor {
        resize: none;
        outline: 0;
    }

    .knowledge-editor:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px var(--border-focus);
    }

    @@media (max-width: 1180px) {
        .knowledge-layout,
        .workspace-grid {
            grid-template-columns: 1fr;
        }

        .knowledge-sidebar {
            position: static;
        }
    }

    @@media (max-width: 640px) {
        .editor-toolbar,
        .section-title-row {
            flex-direction: column;
        }

        .toolbar-actions {
            justify-content: flex-start;
        }
    }
</style>

@code {
    private List<Tenant> tenants = new();
    private Tenant? selectedTenant;
    private string selectedTenantId = string.Empty;
    private string rawTextToAdd = string.Empty;
    private string currentKnowledge = string.Empty;
    private string originalKnowledge = string.Empty;
    private string sourceLabel = string.Empty;
    private string selectedFileName = string.Empty;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private string lastUpdatedLabel = "Not tracked";
    private int chunkCount;
    private int clientsWithKnowledge;
    private bool isLoading = true;
    private bool isProcessing;
    private bool isEditing;
    private bool isAdmin;
    private string currentTenantId = string.Empty;
    private KnowledgeWriteMode writeMode = KnowledgeWriteMode.Append;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");
        currentTenantId = user.FindFirst("TenantId")?.Value ?? string.Empty;

        using var context = DbFactory.CreateDbContext();
        tenants = await GetAccessibleTenants(context).OrderBy(t => t.Name).ToListAsync();
        clientsWithKnowledge = tenants.Count(t => !string.IsNullOrWhiteSpace(t.KnowledgeBaseText));
        isLoading = false;

        if (!isAdmin && tenants.Count == 1)
        {
            selectedTenantId = tenants[0].Id.ToString();
            await LoadCurrentKnowledge();
        }
    }

    private async Task OnTenantSelected()
    {
        ResetMessages();
        rawTextToAdd = "";
        sourceLabel = "";
        selectedFileName = "";
        isEditing = false;

        if (string.IsNullOrWhiteSpace(selectedTenantId))
        {
            selectedTenant = null;
            currentKnowledge = "";
            chunkCount = 0;
            return;
        }

        await LoadCurrentKnowledge();
    }

    private async Task LoadCurrentKnowledge()
    {
        if (!Guid.TryParse(selectedTenantId, out var tenantGuid))
            return;

        using var context = DbFactory.CreateDbContext();
        selectedTenant = await GetAccessibleTenants(context).FirstOrDefaultAsync(t => t.Id == tenantGuid);
        currentKnowledge = selectedTenant?.KnowledgeBaseText ?? string.Empty;
        chunkCount = selectedTenant == null
            ? 0
            : await context.KnowledgeChunks.IgnoreQueryFilters().CountAsync(k => k.TenantId == selectedTenant.TenantId);
    }

    private void EnableEdit()
    {
        originalKnowledge = currentKnowledge;
        isEditing = true;
        ResetMessages();
    }

    private void CancelEdit()
    {
        currentKnowledge = originalKnowledge;
        isEditing = false;
        ResetMessages();
    }

    private async Task SaveKnowledgeBase()
    {
        if (selectedTenant == null || isProcessing)
            return;

        isProcessing = true;
        ResetMessages();

        try
        {
            await SaveKnowledgeText(currentKnowledge, KnowledgeWriteMode.Replace, "Manual editor");
            isEditing = false;
            successMessage = "Knowledge saved and chunks rebuilt.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (selectedTenant == null || isProcessing)
            return;

        isProcessing = true;
        ResetMessages();

        try
        {
            var file = e.File;
            selectedFileName = file.Name;

            if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
            {
                errorMessage = "Only PDF uploads are supported.";
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var text = DocumentBroker.ExtractText(memoryStream);
            if (string.IsNullOrWhiteSpace(text))
            {
                errorMessage = "No readable text was found in this PDF.";
                return;
            }

            await SaveKnowledgeText(text, writeMode, string.IsNullOrWhiteSpace(sourceLabel) ? file.Name : sourceLabel);
            successMessage = writeMode == KnowledgeWriteMode.Append
                ? "PDF content appended and chunks rebuilt."
                : "Knowledge replaced from PDF and chunks rebuilt.";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            errorMessage = "PDF could not be processed. Check the file and try again.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task SaveRawText()
    {
        if (selectedTenant == null || string.IsNullOrWhiteSpace(rawTextToAdd) || isProcessing)
            return;

        isProcessing = true;
        ResetMessages();

        try
        {
            await SaveKnowledgeText(rawTextToAdd, writeMode, string.IsNullOrWhiteSpace(sourceLabel) ? "Pasted text" : sourceLabel);
            rawTextToAdd = "";
            successMessage = writeMode == KnowledgeWriteMode.Append
                ? "Text appended and chunks rebuilt."
                : "Knowledge replaced and chunks rebuilt.";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            errorMessage = "Knowledge could not be saved. Check the database connection and try again.";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task SaveKnowledgeText(string text, KnowledgeWriteMode mode, string label)
    {
        if (selectedTenant == null)
            return;

        using var context = DbFactory.CreateDbContext();
        var tenant = await GetAccessibleTenants(context).FirstOrDefaultAsync(t => t.Id == selectedTenant.Id);
        if (tenant == null)
        {
            errorMessage = "Client no longer exists.";
            return;
        }

        var labelledText = ApplySourceLabel(text, label);
        tenant.KnowledgeBaseText = mode == KnowledgeWriteMode.Replace || string.IsNullOrWhiteSpace(tenant.KnowledgeBaseText)
            ? labelledText
            : $"{tenant.KnowledgeBaseText.Trim()}\n\n{labelledText}";

        await RebuildVectorChunksAsync(context, tenant);
        await context.SaveChangesAsync();

        selectedTenant = tenant;
        currentKnowledge = tenant.KnowledgeBaseText;
        originalKnowledge = currentKnowledge;
        chunkCount = await context.KnowledgeChunks.IgnoreQueryFilters().CountAsync(k => k.TenantId == tenant.TenantId);
        clientsWithKnowledge = tenants.Count(t => t.Id == tenant.Id ? !string.IsNullOrWhiteSpace(tenant.KnowledgeBaseText) : !string.IsNullOrWhiteSpace(t.KnowledgeBaseText));
        lastUpdatedLabel = DateTime.Now.ToString("MMM dd, HH:mm");

        var cachedTenant = tenants.FirstOrDefault(t => t.Id == tenant.Id);
        if (cachedTenant != null)
            cachedTenant.KnowledgeBaseText = tenant.KnowledgeBaseText;
    }

    private static string ApplySourceLabel(string text, string label)
    {
        var cleanText = text.Trim();
        var cleanLabel = label.Trim();
        return string.IsNullOrWhiteSpace(cleanLabel)
            ? cleanText
            : $"# Source: {cleanLabel}\n\n{cleanText}";
    }

    private async Task RebuildVectorChunksAsync(HattieDbContext context, Tenant tenant)
    {
        var oldChunks = await context.KnowledgeChunks
            .IgnoreQueryFilters()
            .Where(k => k.TenantId == tenant.TenantId)
            .ToListAsync();
        context.KnowledgeChunks.RemoveRange(oldChunks);

        if (string.IsNullOrWhiteSpace(tenant.KnowledgeBaseText))
            return;

        var chunks = ChunkText(tenant.KnowledgeBaseText, 700);
        foreach (var chunkText in chunks)
        {
            context.KnowledgeChunks.Add(new KnowledgeChunk
            {
                Id = Guid.NewGuid(),
                TenantId = tenant.TenantId,
                Content = chunkText,
                Embedding = GenerateSimpleEmbedding(chunkText),
                CreatedAt = DateTime.UtcNow
            });
        }
    }

    private static List<string> ChunkText(string text, int maxChunkSize)
    {
        var paragraphs = text.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
        var chunks = new List<string>();
        var currentChunk = "";

        foreach (var paragraph in paragraphs)
        {
            var cleanParagraph = paragraph.Trim();
            if (string.IsNullOrWhiteSpace(cleanParagraph))
                continue;

            if (currentChunk.Length + cleanParagraph.Length > maxChunkSize && !string.IsNullOrWhiteSpace(currentChunk))
            {
                chunks.Add(currentChunk.Trim());
                currentChunk = "";
            }

            currentChunk += cleanParagraph + "\n\n";
        }

        if (!string.IsNullOrWhiteSpace(currentChunk))
            chunks.Add(currentChunk.Trim());

        return chunks;
    }

    private static float[] GenerateSimpleEmbedding(string text)
    {
        const int dimensions = 768;
        var embedding = new float[dimensions];
        var words = text.ToLowerInvariant().Split(' ', StringSplitOptions.RemoveEmptyEntries);

        foreach (var word in words)
        {
            var hash = word.GetHashCode();
            var index = Math.Abs(hash) % dimensions;
            embedding[index] += 1.0f;
        }

        var magnitude = (float)Math.Sqrt(embedding.Sum(x => x * x));
        if (magnitude > 0)
        {
            for (var i = 0; i < dimensions; i++)
                embedding[i] /= magnitude;
        }

        return embedding;
    }

    private void ResetMessages()
    {
        successMessage = "";
        errorMessage = "";
    }

    private static string GetInitial(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "?" : value.Trim()[0].ToString().ToUpperInvariant();
    }

    private IQueryable<Tenant> GetAccessibleTenants(HattieDbContext context)
    {
        var tenantsQuery = context.Tenants.IgnoreQueryFilters();
        return isAdmin ? tenantsQuery : tenantsQuery.Where(t => t.TenantId == currentTenantId);
    }

    private enum KnowledgeWriteMode
    {
        Append,
        Replace
    }
}
