@page "/client-configuration"
@using HattieAI.Domain.Entities
@using HattieAI.Infrastructure.Persistence
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@attribute [Authorize]
@inject IDbContextFactory<HattieDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Configuration | Hattie AI</PageTitle>

<div class="portal-page">
    <div class="page-heading">
        <div>
            <h1>Configuration</h1>
            <p>Control each chatbot's supported languages and approved website origins.</p>
        </div>
        <div class="heading-actions">
            <span class="metric-pill">@tenants.Count clients</span>
            <span class="metric-pill">@allLanguages.Count languages</span>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="state-panel">
            <div class="spinner-border text-primary" role="status"></div>
            <span>Loading configuration data...</span>
        </div>
    }
    else if (!tenants.Any())
    {
        <div class="state-panel">
            <i class="bi bi-people"></i>
            <strong>No clients yet</strong>
            <span>Create a client before configuring chatbot languages or website access.</span>
            @if (isAdmin)
            {
                <a href="clients" class="btn btn-primary mt-2">Create Client</a>
            }
        </div>
    }
    else
    {
        <div class="config-layout">
            <aside class="client-panel">
                <div class="panel-header">
                    <span>Clients</span>
                    <small>@configuredClientCount configured</small>
                </div>

                <div class="client-search">
                    <i class="bi bi-search"></i>
                    <input type="search" placeholder="Search clients" @bind="clientSearch" @bind:event="oninput" />
                </div>

                <div class="client-list">
                    @foreach (var tenant in FilteredTenants)
                    {
                        <button class="client-row @(selectedTenant?.Id == tenant.Id ? "active" : "")" @onclick="() => SelectTenant(tenant.Id)">
                            <span class="client-avatar">@GetInitial(tenant.Name)</span>
                            <span class="client-copy">
                                <strong>@tenant.Name</strong>
                                <small>@GetTenantStatus(tenant)</small>
                            </span>
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    }
                </div>
            </aside>

            <section class="config-panel">
                @if (selectedTenant == null)
                {
                    <div class="state-panel embedded">
                        <i class="bi bi-sliders"></i>
                        <strong>Select a client</strong>
                        <span>Choose a client to manage languages and allowed websites.</span>
                    </div>
                }
                else
                {
                    <div class="config-header">
                        <div>
                            <h2>@selectedTenant.Name</h2>
                            <p>@selectedTenant.ContactEmail</p>
                        </div>
                        <button class="btn btn-primary" @onclick="SaveConfiguration" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                            }
                            <span>@(isSaving ? "Saving..." : "Save Changes")</span>
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(successMessage))
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-2"></i>@successMessage
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
                        </div>
                    }

                    <div class="setup-summary">
                        <div>
                            <span>Languages</span>
                            <strong>@selectedLanguageCodes.Count</strong>
                        </div>
                        <div>
                            <span>Allowed Websites</span>
                            <strong>@allowedOrigins.Count</strong>
                        </div>
                        <div>
                            <span>Knowledge</span>
                            <strong>@(string.IsNullOrWhiteSpace(selectedTenant.KnowledgeBaseText) ? "Missing" : "Ready")</strong>
                        </div>
                    </div>

                    <div class="config-section">
                        <div class="section-header">
                            <div>
                                <h3>Supported Languages</h3>
                                <p>Visitors can switch only between selected languages in the chatbot.</p>
                            </div>
                            <div class="section-actions">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="SelectCoreLanguages">Core</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="SelectAllLanguages">All</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearLanguages">Clear</button>
                            </div>
                        </div>

                        <div class="field-with-icon">
                            <i class="bi bi-search"></i>
                            <input type="search" placeholder="Search language or code" @bind="languageSearch" @bind:event="oninput" />
                        </div>

                        <div class="language-grid">
                            @foreach (var language in FilteredLanguages)
                            {
                                <button class="language-tile @(IsLanguageSelected(language.Code) ? "selected" : "")" @onclick="() => ToggleLanguage(language.Code)">
                                    <span class="check-box">
                                        @if (IsLanguageSelected(language.Code))
                                        {
                                            <i class="bi bi-check-lg"></i>
                                        }
                                    </span>
                                    <span class="language-name">@language.Name</span>
                                    <span class="language-code">@language.Code</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="config-section">
                        <div class="section-header">
                            <div>
                                <h3>Allowed Websites</h3>
                                <p>Add exact origins where the chatbot script is allowed to connect.</p>
                            </div>
                        </div>

                        <div class="origin-input-row">
                            <input class="form-control" placeholder="https://example.com" @bind="newOriginUrl" @bind:event="oninput" @onkeydown="HandleOriginKeyDown" />
                            <button class="btn btn-outline-primary" type="button" @onclick="AddOrigin">Add</button>
                        </div>

                        @if (allowedOrigins.Any())
                        {
                            <div class="origin-list">
                                @foreach (var origin in allowedOrigins)
                                {
                                    <div class="origin-item">
                                        <i class="bi bi-globe2"></i>
                                        <span>@origin</span>
                                        <button class="btn-icon-danger" @onclick="() => RemoveOrigin(origin)" title="Remove origin">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="inline-empty">
                                <i class="bi bi-exclamation-circle"></i>
                                No websites added. Add the production website before going live.
                            </div>
                        }
                    </div>

                    <div class="config-section">
                        <div class="section-header">
                            <div>
                                <h3>AI Lead Collection</h3>
                                <p>Enable automatic lead extraction by Hattie AI from chat conversations.</p>
                            </div>
                        </div>

                        <div class="lead-config-card p-3 border rounded bg-light mt-3">
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="enableLeadCollection" @bind="isLeadCollectionEnabled" />
                                <label class="form-check-label fw-bold text-dark mb-0" for="enableLeadCollection" style="cursor: pointer;">Enable Lead Collection</label>
                            </div>
                            
                            @if (isLeadCollectionEnabled)
                            {
                                <div class="mb-2">
                                    <label class="form-label small fw-bold text-muted" for="leadInstructions">Lead Collection Instructions</label>
                                    <textarea class="form-control" id="leadInstructions" rows="3" 
                                              placeholder="Specify what details to collect and when... E.g. Ask for name, email, and phone when they ask for custom pricing." 
                                              @bind="leadCollectionInstruction"></textarea>
                                    <div class="form-text text-muted" style="font-size: 0.72rem;">These instructions direct the AI on what fields (like name, email, phone) to extract from conversations to register in the CRM.</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>
        </div>
    }
</div>

<style>
    .config-layout {
        display: grid;
        grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
        gap: 1.25rem;
        align-items: start;
    }

    .client-panel,
    .config-panel {
        background: var(--surface-color);
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-sm);
    }

    .client-panel {
        position: sticky;
        top: 0;
        overflow: hidden;
    }

    .panel-header,
    .config-header,
    .section-header {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
    }

    .panel-header {
        padding: 1rem;
        border-bottom: 1px solid var(--border-color);
        font-weight: 800;
    }

    .panel-header small,
    .section-header p,
    .config-header p {
        color: var(--text-muted);
        margin: 0;
    }

    .client-search,
    .field-with-icon {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        background: #f8fafc;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        margin: 1rem;
        padding: 0.65rem 0.75rem;
        color: var(--text-muted);
    }

    .client-search input,
    .field-with-icon input {
        border: 0;
        background: transparent;
        outline: 0;
        width: 100%;
        color: var(--text-color);
    }

    .field-with-icon {
        margin: 0 0 1rem;
    }

    .client-list {
        max-height: calc(100vh - 260px);
        overflow-y: auto;
        padding: 0 0.6rem 0.6rem;
    }

    .client-row {
        width: 100%;
        border: 0;
        background: transparent;
        display: grid;
        grid-template-columns: 38px 1fr 16px;
        gap: 0.75rem;
        align-items: center;
        text-align: left;
        padding: 0.75rem;
        border-radius: 8px;
        color: var(--text-color);
    }

    .client-row:hover {
        background: #f8fafc;
    }

    .client-row.active {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .client-avatar {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: #e0f2fe;
        color: #075985;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .client-copy {
        min-width: 0;
        display: flex;
        flex-direction: column;
    }

    .client-copy strong,
    .client-copy small {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .client-copy small {
        color: var(--text-muted);
    }

    .config-panel {
        padding: 1.25rem;
    }

    .config-header {
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
        margin-bottom: 1rem;
    }

    .config-header h2,
    .section-header h3 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 800;
    }

    .setup-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .setup-summary div {
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: #f8fafc;
        padding: 0.9rem;
    }

    .setup-summary span {
        display: block;
        color: var(--text-muted);
        font-size: 0.8rem;
        font-weight: 700;
    }

    .setup-summary strong {
        display: block;
        margin-top: 0.25rem;
        font-size: 1.2rem;
    }

    .config-section {
        border-top: 1px solid var(--border-color);
        padding-top: 1.25rem;
        margin-top: 1.25rem;
    }

    .section-actions {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
    }

    .language-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 0.65rem;
        max-height: 430px;
        overflow-y: auto;
        padding-right: 0.25rem;
    }

    .language-tile {
        display: grid;
        grid-template-columns: 22px minmax(0, 1fr) auto;
        gap: 0.6rem;
        align-items: center;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: #ffffff;
        padding: 0.7rem;
        text-align: left;
        color: var(--text-color);
    }

    .language-tile:hover {
        border-color: var(--primary-light);
        background: #f8fafc;
    }

    .language-tile.selected {
        border-color: #2563eb;
        background: #eff6ff;
    }

    .check-box {
        width: 22px;
        height: 22px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .language-tile.selected .check-box {
        background: #2563eb;
        border-color: #2563eb;
    }

    .language-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 700;
    }

    .language-code {
        color: var(--text-muted);
        background: #f1f5f9;
        border-radius: 999px;
        padding: 0.15rem 0.45rem;
        font-size: 0.75rem;
        font-weight: 800;
    }

    .origin-input-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.6rem;
    }

    .origin-list {
        display: grid;
        gap: 0.5rem;
        margin-top: 0.85rem;
    }

    .origin-item {
        display: grid;
        grid-template-columns: 22px minmax(0, 1fr) 34px;
        align-items: center;
        gap: 0.7rem;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 0.65rem 0.75rem;
    }

    .origin-item span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .btn-icon-danger {
        border: 0;
        background: transparent;
        color: var(--danger-color);
        width: 34px;
        height: 34px;
        border-radius: 8px;
    }

    .btn-icon-danger:hover {
        background: #fee2e2;
    }

    .inline-empty {
        margin-top: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        color: #92400e;
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 8px;
        padding: 0.8rem;
    }

    @@media (max-width: 1000px) {
        .config-layout {
            grid-template-columns: 1fr;
        }

        .client-panel {
            position: static;
        }

        .setup-summary {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .panel-header,
        .config-header,
        .section-header,
        .heading-actions {
            align-items: flex-start;
            flex-direction: column;
        }

        .origin-input-row {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private List<Tenant> tenants = new();
    private List<Language> allLanguages = new();
    private Tenant? selectedTenant;
    private HashSet<string> selectedLanguageCodes = new();
    private List<string> allowedOrigins = new();
    private string newOriginUrl = "";
    private string clientSearch = "";
    private string languageSearch = "";
    private bool isLoading = true;
    private bool isSaving;
    private bool isAdmin;
    private string currentTenantId = string.Empty;
    private string successMessage = "";
    private string errorMessage = "";
    private bool isLeadCollectionEnabled;
    private string leadCollectionInstruction = "";

    private IEnumerable<Tenant> FilteredTenants =>
        string.IsNullOrWhiteSpace(clientSearch)
            ? tenants
            : tenants.Where(t => t.Name.Contains(clientSearch, StringComparison.OrdinalIgnoreCase) ||
                                 t.ContactEmail.Contains(clientSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<Language> FilteredLanguages =>
        string.IsNullOrWhiteSpace(languageSearch)
            ? allLanguages
            : allLanguages.Where(l => l.Name.Contains(languageSearch, StringComparison.OrdinalIgnoreCase) ||
                                      l.Code.Contains(languageSearch, StringComparison.OrdinalIgnoreCase));

    private int configuredClientCount => tenants.Count(t =>
        (t.AllowedOrigins?.Any() == true) || !string.IsNullOrWhiteSpace(t.KnowledgeBaseText));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");
        currentTenantId = user.FindFirst("TenantId")?.Value ?? string.Empty;

        using var context = DbFactory.CreateDbContext();
        tenants = await GetAccessibleTenants(context)
            .Include(t => t.SupportedLanguages)
            .OrderBy(t => t.Name)
            .ToListAsync();
        allLanguages = await context.Languages.OrderBy(l => l.Name).ToListAsync();
        isLoading = false;

        if (!isAdmin && tenants.Count == 1)
            await SelectTenant(tenants[0].Id);
    }

    private async Task SelectTenant(Guid tenantId)
    {
        successMessage = "";
        errorMessage = "";

        using var context = DbFactory.CreateDbContext();
        selectedTenant = await GetAccessibleTenants(context)
            .Include(t => t.SupportedLanguages)
            .FirstOrDefaultAsync(t => t.Id == tenantId);

        selectedLanguageCodes = selectedTenant?.SupportedLanguages.Select(l => l.Code).ToHashSet() ?? new();
        allowedOrigins = selectedTenant?.AllowedOrigins?.ToList() ?? new();
        languageSearch = "";
        newOriginUrl = "";
        isLeadCollectionEnabled = selectedTenant?.IsLeadCollectionEnabled ?? false;
        leadCollectionInstruction = selectedTenant?.LeadCollectionInstruction ?? string.Empty;
    }

    private bool IsLanguageSelected(string code) => selectedLanguageCodes.Contains(code);

    private void ToggleLanguage(string code)
    {
        successMessage = "";
        if (!selectedLanguageCodes.Add(code))
            selectedLanguageCodes.Remove(code);
    }

    private void SelectCoreLanguages()
    {
        selectedLanguageCodes = new HashSet<string>(new[] { "en", "hi", "ar", "es", "fr" });
        successMessage = "";
    }

    private void SelectAllLanguages()
    {
        selectedLanguageCodes = allLanguages.Select(l => l.Code).ToHashSet();
        successMessage = "";
    }

    private void ClearLanguages()
    {
        selectedLanguageCodes.Clear();
        successMessage = "";
    }

    private void AddOrigin()
    {
        successMessage = "";
        errorMessage = "";

        var url = newOriginUrl.Trim().TrimEnd('/');
        if (string.IsNullOrWhiteSpace(url))
            return;

        if (!IsValidOrigin(url))
        {
            errorMessage = "Enter a valid origin such as https://example.com. Do not include paths.";
            return;
        }

        if (allowedOrigins.Contains(url, StringComparer.OrdinalIgnoreCase))
        {
            errorMessage = "This website is already in the allowlist.";
            return;
        }

        allowedOrigins.Add(url);
        newOriginUrl = "";
    }

    private void HandleOriginKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddOrigin();
    }

    private void RemoveOrigin(string origin)
    {
        allowedOrigins.Remove(origin);
        successMessage = "";
    }

    private async Task SaveConfiguration()
    {
        if (selectedTenant == null || isSaving)
            return;

        if (!selectedLanguageCodes.Any())
        {
            errorMessage = "Select at least one supported language.";
            return;
        }

        isSaving = true;
        successMessage = "";
        errorMessage = "";

        try
        {
            using var context = DbFactory.CreateDbContext();
            var tenantToUpdate = await GetAccessibleTenants(context)
                .Include(t => t.SupportedLanguages)
                .FirstOrDefaultAsync(t => t.Id == selectedTenant.Id);

            if (tenantToUpdate == null)
            {
                errorMessage = "Client no longer exists.";
                return;
            }

            tenantToUpdate.SupportedLanguages.Clear();
            var languagesToAdd = await context.Languages
                .Where(l => selectedLanguageCodes.Contains(l.Code))
                .ToListAsync();

            foreach (var language in languagesToAdd)
                tenantToUpdate.SupportedLanguages.Add(language);

            tenantToUpdate.AllowedOrigins = allowedOrigins.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            tenantToUpdate.IsLeadCollectionEnabled = isLeadCollectionEnabled;
            tenantToUpdate.LeadCollectionInstruction = leadCollectionInstruction;
            await context.SaveChangesAsync();

            selectedTenant = tenantToUpdate;
            var cached = tenants.FirstOrDefault(t => t.Id == tenantToUpdate.Id);
            if (cached != null)
            {
                cached.AllowedOrigins = tenantToUpdate.AllowedOrigins;
                cached.KnowledgeBaseText = tenantToUpdate.KnowledgeBaseText;
                cached.SupportedLanguages = tenantToUpdate.SupportedLanguages;
                cached.IsLeadCollectionEnabled = tenantToUpdate.IsLeadCollectionEnabled;
                cached.LeadCollectionInstruction = tenantToUpdate.LeadCollectionInstruction;
            }

            successMessage = "Configuration saved.";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            errorMessage = "Configuration could not be saved. Check the database connection and try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static bool IsValidOrigin(string origin)
    {
        return Uri.TryCreate(origin, UriKind.Absolute, out var uri) &&
               (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps) &&
               !string.IsNullOrWhiteSpace(uri.Host) &&
               string.IsNullOrWhiteSpace(uri.PathAndQuery.Trim('/'));
    }

    private static string GetInitial(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "?" : value.Trim()[0].ToString().ToUpperInvariant();
    }

    private static string GetTenantStatus(Tenant tenant)
    {
        var parts = new List<string>();
        if (tenant.SupportedLanguages?.Any() == true)
            parts.Add($"{tenant.SupportedLanguages.Count} languages");
        if (tenant.AllowedOrigins?.Any() == true)
            parts.Add($"{tenant.AllowedOrigins.Count} websites");
        return parts.Any() ? string.Join(" / ", parts) : "Needs setup";
    }

    private IQueryable<Tenant> GetAccessibleTenants(HattieDbContext context)
    {
        var tenantsQuery = context.Tenants.IgnoreQueryFilters();
        return isAdmin ? tenantsQuery : tenantsQuery.Where(t => t.TenantId == currentTenantId);
    }
}
